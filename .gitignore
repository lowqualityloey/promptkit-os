# The three directories previously negated here were retired; they remain
# recoverable from git history prior to that removal.
.kiro/

# Better-PromptKit isolated worktrees
.worktrees/

# Local agent-tool artifacts (machine-specific, never published).
# Note: AGENTS.md stays in .git/info/exclude only — personal workspace config;
# a committed rule would also block contributors from tracking their own AGENTS.md.
tmp/
.kilo/
.senpi/
.zcode/
.freebuff/
.codegraph
.mcp.json
.debug-journal.md
# Stray PowerShell provider-path artifact (Microsoft.PowerShell.Core/FileSystem::)
Microsoft.PowerShell.Core/

# Published benchmark batches intentionally track their run and harness logs.
!benchmarks/runs/**/*.log

# A benchmark run directory holds a complete seed clone plus the packet files
# the batch publishes. Track only the packet; the clone (including its .git)
# stays local. Batch-root `runs/<scenario>-run.diff` and `-init.log` are not
# matched here and stay publishable.
benchmarks/runs/*/runs/*/**
!benchmarks/runs/*/runs/*/record.json
!benchmarks/runs/*/runs/*/run.stripped.diff
!benchmarks/runs/*/runs/*/verify.txt
!benchmarks/runs/*/runs/*/session.log
!benchmarks/runs/*/runs/*/extract.log
!benchmarks/runs/*/runs/*/strip.log

