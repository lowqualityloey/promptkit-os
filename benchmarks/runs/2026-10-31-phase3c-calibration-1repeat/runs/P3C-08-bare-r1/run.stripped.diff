+test('caps every delay at jitterCapMs as the exponential base grows', async () => {
+  const queue = queueWith('doomed');
+  const delays = [];
+
+  await dispatch(
+    queue,
+    async () => {
+      throw new Error('nope');
+    },
+    {
+      maxAttempts: 4,
+      baseDelayMs: 100,
+      jitterCapMs: 150,
+      jitter: () => 0.5,
+      sleep: async (delayMs) => {
+        delays.push(delayMs);
+      },
+    },
+  );
+
+  assert.deepEqual(delays, [50, 75, 75]);
+  assert.ok(delays.every((delayMs) => delayMs <= 150));
+});
