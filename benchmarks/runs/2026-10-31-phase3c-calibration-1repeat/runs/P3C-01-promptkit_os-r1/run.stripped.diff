+test('counts a retried job once, whatever its outcome', async () => {
+  const queue = queueWith('flaky', 'doomed');
+  const metrics = createMetrics();
+  const calls = new Map();
+
+  await dispatch(
+    queue,
+    async (job) => {
+      const seen = (calls.get(job.id) || 0) + 1;
+      calls.set(job.id, seen);
+      if (job.id === 'flaky' && seen < 3) throw new Error('transient');
+      if (job.id === 'doomed') throw new Error('permanent');
+      return job.id;
+    },
+    { metrics, maxAttempts: 3, sleep: async () => {} },
+  );
+
+  assert.equal(calls.get('flaky'), 3);
+  assert.equal(calls.get('doomed'), 3);
+  assert.deepEqual(metrics.snapshot(), { jobs: 2, processed: 1, failed: 1 });
+});
+
