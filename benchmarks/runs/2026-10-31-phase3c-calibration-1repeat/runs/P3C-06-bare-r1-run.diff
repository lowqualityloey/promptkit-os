+test('sweep drains the queue and returns how many jobs ran', async () => {
+  const queue = createQueue({ capacity: 4 });
+  for (const id of ['a', 'b', 'bad', 'd']) queue.enqueue({ id });
+  const seen = [];
+
+  const ran = await sweep(
+    queue,
+    async (job) => {
+      if (job.id === 'bad') throw new Error('nope');
+      seen.push(job.id);
+      return job.id;
+    },
+    { maxAttempts: 1, sleep: async () => {} },
+  );
+
+  assert.equal(ran, 4);
+  assert.equal(queue.size, 0);
+  assert.deepEqual(seen, ['a', 'b', 'd']);
