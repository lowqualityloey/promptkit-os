+
+test('sweep returns zero for an empty queue', async () => {
+  const queue = createQueue();
+  assert.equal(await sweep(queue, async () => 'ok'), 0);
+});
+
+test('sweep forwards the dispatch options, including retries', async () => {
+  const queue = createQueue({ capacity: 2 });
+  queue.enqueue({ id: 'flaky' });
+  queue.enqueue({ id: 'ok' });
+  let calls = 0;
+
+  const ran = await sweep(
+    queue,
+    async (job) => {
+      if (job.id === 'flaky') {
+        calls += 1;
+        if (calls < 3) throw new Error('transient');
+      }
+      return job.id;
+    },
+    { maxAttempts: 3, sleep: async () => {} },
+  );
+
+  assert.equal(ran, 2);
+  assert.equal(calls, 3);
+  assert.equal(queue.size, 0);
+});
