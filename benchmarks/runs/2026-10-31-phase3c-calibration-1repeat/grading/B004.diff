+test('counts a retried job once, by its final outcome', async () => {
+  const queue = queueWith('flaky');
+  const metrics = createMetrics();
+  let calls = 0;
+
+  await dispatch(
+    queue,
+    async () => {
+      calls += 1;
+      if (calls < 3) throw new Error('transient');
+      return 'ok';
+    },
+    { metrics, sleep: async () => {} },
+  );
+
+  assert.equal(calls, 3);
+  assert.deepEqual(metrics.snapshot(), { jobs: 1, processed: 1, failed: 0 });
+});
+
+test('counts an exhausted job once, as failed', async () => {
+  const queue = queueWith('bad');
+  const metrics = createMetrics();
+  let calls = 0;
+
+  await dispatch(
+    queue,
+    async () => {
+      calls += 1;
+      throw new Error('boom');
+    },
+    { metrics, maxAttempts: 3, sleep: async () => {} },
+  );
+
+  assert.equal(calls, 3);
+  assert.deepEqual(metrics.snapshot(), { jobs: 1, processed: 0, failed: 1 });
+});
+
