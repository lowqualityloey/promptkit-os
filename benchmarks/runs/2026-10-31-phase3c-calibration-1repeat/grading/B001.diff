+test('caps the exponential backoff schedule at jitterCapMs', async () => {
+  const queue = queueWith('doomed');
+  const delays = [];
+
+  await dispatch(
+    queue,
+    async () => {
+      throw new Error('nope');
+    },
+    {
+      maxAttempts: 4,
+      baseDelayMs: 100,
+      jitterCapMs: 250,
+      jitter: () => 0.5,
+      sleep: async (delayMs) => {
+        delays.push(delayMs);
+      },
+    },
+  );
+
+  assert.deepEqual(delays, [50, 100, 125]);
+  assert.ok(delays.every((delayMs) => delayMs <= 250));
+});
