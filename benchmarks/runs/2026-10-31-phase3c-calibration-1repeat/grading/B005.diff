+import { createScheduler, sweep } from '../src/scheduler.js';
+import { createQueue } from '../src/queue.js';
+
+function queueWith(...ids) {
+  const queue = createQueue({ capacity: ids.length + 1 });
+  for (const id of ids) queue.enqueue({ id });
+  return queue;
+}
+
+test('sweep drains the queue and reports how many jobs ran', async () => {
+  const queue = queueWith('a', 'b');
+  const seen = [];
+
+  const ran = await sweep(queue, async (job) => {
+    seen.push(job.id);
+    return job.id;
+  });
+
+  assert.equal(ran, 2);
+  assert.deepEqual(seen, ['a', 'b']);
+  assert.equal(queue.size, 0);
+});
+
+test('sweep passes the dispatch options through and counts a retried job once', async () => {
+  const queue = queueWith('bad');
+  const lines = [];
+  let calls = 0;
+
+  const ran = await sweep(
+    queue,
+    async () => {
+      calls += 1;
+      throw new Error('nope');
+    },
+    { maxAttempts: 3, sleep: async () => {}, log: (line) => lines.push(line) },
+  );
+
+  assert.equal(ran, 1);
+  assert.equal(calls, 3);
+  assert.deepEqual(lines, ['fail bad: nope']);
+  assert.equal(queue.size, 0);
+});
+
+test('sweep on an empty queue runs nothing', async () => {
