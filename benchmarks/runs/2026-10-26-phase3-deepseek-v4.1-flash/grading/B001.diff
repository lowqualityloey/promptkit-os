+Assert-Contains "templates/agent-directive-lite-template.md" 'Protocols: .*\{setup,context-sync,code-quality-gate,subagent-delegation\}' "Lite directive protocols line names setup (the transitive entry point)"
+Assert-Contains "protocols/setup.md" '\*\*Context Economy\*\*: .*context-economy\.md' "Setup Workflows & Protocols Reference lists context-economy.md"
+Assert-Contains "docs/WORKFLOW-MAP.md" '\[`protocols/context-economy\.md`\]\(\.\./protocols/context-economy\.md\)' "Workflow map links protocols/context-economy.md"
+Assert-Contains "protocols/context-economy.md" 'behavioral contract suites.*assert that route' "Context Economy states the route is exercised by automated checks"
+Assert-NotContains "protocols/context-economy.md" 'no automated check exercises it' "Context Economy no longer claims no automated check exercises the route"
+Assert-Contains "protocols/context-economy.md" 'been validated with recorded live transcripts' "Context Economy keeps live transcript validation open"
+
 Write-Host "📊 Behavioral Contract Verification Summary" -ForegroundColor Cyan
