+    let attempts = 0;
+    let result;
+    let error;
+    let succeeded = false;
+
+    while (attempts < maxAttempts) {
+      attempts += 1;
+      try {
+        result = await handler(job);
+        succeeded = true;
+        break;
+      } catch (attemptError) {
+        error = attemptError;
+        if (attempts < maxAttempts) {
+          await sleep(baseDelayMs * 2 ** (attempts - 1));
