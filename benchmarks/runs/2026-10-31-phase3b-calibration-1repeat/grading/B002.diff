diff --git a/test/dispatcher.test.js b/test/dispatcher.test.js
index 53798d9..54e188b 100644
--- a/test/dispatcher.test.js
+++ b/test/dispatcher.test.js
@@ -60,3 +60,177 @@ test('returns empty results for an empty queue', async () => {
   assert.deepEqual(result.failed, []);
   assert.equal(result.total, 0);
 });
+
+test('retries a failed handler and records it once when it later succeeds', async () => {
+  const queue = queueWith({ id: 'flaky' });
+  const delays = [];
+  const lines = [];
+  let calls = 0;
+
+  const result = await dispatch(
+    queue,
+    async (job) => {
+      calls += 1;
+      if (calls < 3) throw new Error(`attempt ${calls} failed`);
+      return 'recovered';
+    },
+    {
+      log: (line) => lines.push(line),
+      sleep: async (delay) => {
+        delays.push(delay);
+      },
+    },
+  );
+
+  assert.equal(calls, 3);
+  assert.deepEqual(delays, [100, 200]);
+  assert.equal(result.processed.length, 1);
+  assert.equal(result.processed[0].result, 'recovered');
+  assert.equal(result.processed[0].attempts, 3);
+  assert.equal(result.failed.length, 0);
+  assert.equal(result.total, 1);
+  assert.deepEqual(lines, ['ok flaky']);
+});
+
+test('exhausts attempts and records the last error once', async () => {
+  const queue = queueWith({ id: 'broken' });
+  const delays = [];
+  const lines = [];
+  let calls = 0;
+
+  const result = await dispatch(
+    queue,
+    async () => {
+      calls += 1;
+      throw new Error(`failure ${calls}`);
+    },
+    {
+      log: (line) => lines.push(line),
+      sleep: async (delay) => {
+        delays.push(delay);
+      },
+    },
+  );
+
+  assert.equal(calls, 3);
+  assert.deepEqual(delays, [100, 200]);
+  assert.equal(result.processed.length, 0);
+  assert.equal(result.failed.length, 1);
+  assert.equal(result.failed[0].job.id, 'broken');
+  assert.equal(result.failed[0].attempts, 3);
+  assert.match(result.failed[0].error.message, /failure 3/);
+  assert.equal(result.total, 1);
+  assert.deepEqual(lines, ['fail broken: failure 3']);
+});
+
+test('backs off exponentially from a custom baseDelayMs', async () => {
+  const queue = queueWith({ id: 'x' });
+  const delays = [];
+
+  await dispatch(
+    queue,
+    async () => {
+      throw new Error('nope');
+    },
+    {
+      maxAttempts: 4,
+      baseDelayMs: 25,
+      sleep: async (delay) => {
+        delays.push(delay);
+      },
+    },
+  );
+
+  assert.deepEqual(delays, [25, 50, 100]);
+});
+
+test('maxAttempts 1 disables retries and never sleeps', async () => {
+  const queue = queueWith({ id: 'a' }, { id: 'b' });
+  const delays = [];
+  const seen = [];
+
+  const result = await dispatch(
+    queue,
+    async (job) => {
+      seen.push(job.id);
+      throw new Error('always fails');
+    },
+    {
+      maxAttempts: 1,
+      sleep: async (delay) => {
+        delays.push(delay);
+      },
+    },
+  );
+
+  assert.deepEqual(seen, ['a', 'b']);
+  assert.deepEqual(delays, []);
+  assert.equal(result.processed.length, 0);
+  assert.equal(result.failed.length, 2);
+  assert.deepEqual(
+    result.failed.map((entry) => entry.attempts),
+    [1, 1],
+  );
+  assert.equal(result.total, 2);
+});
+
+test('records attempts per job independently', async () => {
+  const queue = queueWith({ id: 'a' }, { id: 'b' });
+  const calls = { a: 0, b: 0 };
+
+  const result = await dispatch(
+    queue,
+    async (job) => {
+      calls[job.id] += 1;
+      if (job.id === 'a' && calls.a < 2) throw new Error('flaky');
+      return job.id;
+    },
+    { sleep: async () => {} },
+  );
+
+  assert.deepEqual(
+    result.processed.map((entry) => [entry.job.id, entry.attempts]),
+    [
+      ['a', 2],
+      ['b', 1],
+    ],
+  );
+  assert.equal(result.failed.length, 0);
+  assert.equal(result.total, 2);
+});
+
+test('throws RangeError before dequeuing when maxAttempts is invalid', async () => {
+  for (const maxAttempts of [0, -1, 1.5, 2.0001, '3', null, NaN, Infinity]) {
+    const queue = queueWith({ id: 'a' }, { id: 'b' });
+    let calls = 0;
+
+    await assert.rejects(
+      dispatch(queue, async () => {
+        calls += 1;
+        return 'ok';
+      }, { maxAttempts, sleep: async () => {} }),
+      RangeError,
+    );
+
+    assert.equal(calls, 0);
+    assert.equal(queue.size, 2);
+  }
+});
+
+test('throws RangeError before dequeuing when baseDelayMs is invalid', async () => {
+  for (const baseDelayMs of [-1, 0.5, -0.5, '100', null, NaN, Infinity]) {
+    const queue = queueWith({ id: 'a' }, { id: 'b' });
+    let calls = 0;
+
+    await assert.rejects(
+      dispatch(queue, async () => {
+        calls += 1;
+        return 'ok';
+      }, { baseDelayMs, sleep: async () => {} }),
+      RangeError,
+    );
+
+    assert.equal(calls, 0);
+    assert.equal(queue.size, 2);
+  }
+});
