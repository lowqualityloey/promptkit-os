+test('enqueueMany appends every item in order and returns the new size', () => {
+  const queue = createQueue({ capacity: 5 });
+  queue.enqueue('a');
+
+  assert.equal(queue.enqueueMany(['b', 'c']), 3);
+  assert.equal(queue.size, 3);
+  assert.deepEqual(queue.drain(), ['a', 'b', 'c']);
+});
+
+test('enqueueMany fills the queue exactly to capacity', () => {
+  const queue = createQueue({ capacity: 2 });
+
+  assert.equal(queue.enqueueMany(['a', 'b']), 2);
+  assert.equal(queue.isFull, true);
+});
+
+test('enqueueMany throws QueueFullError and appends nothing when the batch does not fit', () => {
+  const queue = createQueue({ capacity: 3 });
+  queue.enqueue('head');
+  queue.enqueue('second');
+
+  assert.throws(
+    () => queue.enqueueMany(['x', 'y']),
+    (error) => error instanceof QueueFullError && error.capacity === 3,
+  );
+  assert.equal(queue.size, 2);
+  assert.deepEqual(queue.drain(), ['head', 'second']);
+});
+
+test('enqueueMany throws when a full queue receives a non-empty batch', () => {
+  const queue = createQueue({ capacity: 1 });
+  queue.enqueue('only');
+
+  assert.throws(() => queue.enqueueMany(['overflow']), QueueFullError);
+  assert.equal(queue.size, 1);
+  assert.equal(queue.dequeue(), 'only');
+});
+
+test('enqueueMany with an empty array is a no-op that returns the current size', () => {
+  const queue = createQueue({ capacity: 2 });
+  queue.enqueue('a');
+
+  assert.equal(queue.enqueueMany([]), 1);
+  assert.equal(queue.size, 1);
+  assert.equal(queue.dequeue(), 'a');
+});
+
