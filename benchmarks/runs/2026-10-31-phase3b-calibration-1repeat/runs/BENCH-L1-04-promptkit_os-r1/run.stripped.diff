+test('a dry run validates and prints one dry-run line without a queue', () => {
+  const sunk = capture();
+  const result = main(['--DRY_RUN=1', '--PORT=9090'], {}, sunk.io);
+
+  assert.equal(result.exitCode, 0);
+  assert.deepEqual(result.config, { port: 9090, level: 'info', capacity: 100 });
+  assert.deepEqual(sunk.out, ['dry-run port=9090 level=info capacity=100']);
+  assert.deepEqual(sunk.err, []);
+  assert.equal(result.queue, undefined);
+});
+
+test('a bare dry-run flag counts as present', () => {
+  const sunk = capture();
+  const result = main(['--DRY_RUN'], {}, sunk.io);
+
+  assert.equal(result.exitCode, 0);
+  assert.deepEqual(sunk.out, ['dry-run port=8080 level=info capacity=100']);
+  assert.equal(result.queue, undefined);
+});
+
+test('an invalid configuration in a dry run exits 2 without a queue', () => {
+  const sunk = capture();
+  const result = main(['--DRY_RUN=1', '--LOG_LEVEL=verbose'], {}, sunk.io);
+
+  assert.equal(result.exitCode, 2);
+  assert.deepEqual(sunk.out, []);
+  assert.match(sunk.err[0], /configuration error: LOG_LEVEL must be one of/);
+  assert.equal(result.queue, undefined);
+});
+
