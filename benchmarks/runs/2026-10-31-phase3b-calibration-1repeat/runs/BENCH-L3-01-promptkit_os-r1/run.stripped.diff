-export async function dispatch(queue, handler, { log = () => {} } = {}) {
+function defaultSleep(delayMs) {
+  return new Promise((resolve) => setTimeout(resolve, delayMs));
+}
+
+export async function dispatch(
+  queue,
+  handler,
+  { log = () => {}, maxAttempts = 3, baseDelayMs = 100, sleep = defaultSleep } = {},
+) {
+  if (!Number.isInteger(maxAttempts) || maxAttempts < 1) {
+    throw new RangeError(`maxAttempts must be a positive integer, got: ${maxAttempts}`);
+  }
+  if (!Number.isInteger(baseDelayMs) || baseDelayMs < 0) {
+    throw new RangeError(`baseDelayMs must be a non-negative integer, got: ${baseDelayMs}`);
+  }
+
   const processed = [];
   const failed = [];
 
   while (queue.size > 0) {
     const job = queue.dequeue();
     const id = job && job.id !== undefined ? job.id : 'job';
-    try {
-      const result = await handler(job);
-      processed.push({ job, result });
-      log(`ok ${id}`);
-    } catch (error) {
-      failed.push({ job, error });
-      log(`fail ${id}: ${error.message}`);
+    let attempts = 0;
+
+    for (;;) {
+      attempts += 1;
+      try {
+        const result = await handler(job);
+        processed.push({ job, result, attempts });
+        log(`ok ${id}`);
+        break;
+      } catch (error) {
+        if (attempts >= maxAttempts) {
+          failed.push({ job, error, attempts });
+          log(`fail ${id}: ${error.message}`);
+          break;
+        }
+        await sleep(baseDelayMs * 2 ** (attempts - 1));
+      }
     }
   }
 
diff --git a/test/dispatcher.test.js b/test/dispatcher.test.js
index 53798d9..e9071c0 100644
--- a/test/dispatcher.test.js
+++ b/test/dispatcher.test.js
@@ -60,3 +60,156 @@ test('returns empty results for an empty queue', async () => {
   assert.deepEqual(result.failed, []);
   assert.equal(result.total, 0);
 });
+
+test('retries a failing job and records the attempt that succeeded', async () => {
+  const queue = queueWith({ id: 'flaky' });
+  const delays = [];
+  let calls = 0;
+
+  const result = await dispatch(
+    queue,
+    async () => {
+      calls += 1;
+      if (calls < 3) throw new Error('transient');
+      return 'recovered';
+    },
+    {
+      maxAttempts: 3,
+      baseDelayMs: 10,
+      sleep: async (delayMs) => {
+        delays.push(delayMs);
+      },
+    },
+  );
+
+  assert.equal(calls, 3);
+  assert.equal(result.processed.length, 1);
+  assert.equal(result.processed[0].job.id, 'flaky');
+  assert.equal(result.processed[0].result, 'recovered');
+  assert.equal(result.processed[0].attempts, 3);
+  assert.equal(result.failed.length, 0);
+  assert.equal(result.total, 1);
+  assert.equal(queue.size, 0);
+  assert.deepEqual(delays, [10, 20]);
+});
+
+test('records the last error once a job exhausts its attempts', async () => {
+  const queue = queueWith({ id: 'doomed' });
+  const delays = [];
+  let calls = 0;
+
+  const result = await dispatch(
+    queue,
+    async () => {
+      calls += 1;
+      throw new Error(`boom ${calls}`);
+    },
+    {
+      maxAttempts: 3,
+      baseDelayMs: 5,
+      sleep: async (delayMs) => {
+        delays.push(delayMs);
+      },
+    },
+  );
+
+  assert.equal(calls, 3);
+  assert.equal(result.failed.length, 1);
+  assert.equal(result.failed[0].job.id, 'doomed');
+  assert.match(result.failed[0].error.message, /boom 3/);
+  assert.equal(result.failed[0].attempts, 3);
+  assert.equal(result.processed.length, 0);
+  assert.equal(result.total, 1);
+  assert.deepEqual(delays, [5, 10]);
+});
+
+test('applies exponential backoff between failed attempts', async () => {
+  const queue = queueWith({ id: 'x' });
+  const delays = [];
+
+  await dispatch(
+    queue,
+    async () => {
+      throw new Error('always');
+    },
+    {
+      maxAttempts: 4,
+      baseDelayMs: 7,
+      sleep: async (delayMs) => {
+        delays.push(delayMs);
+      },
+    },
+  );
+
+  assert.deepEqual(delays, [7, 14, 28]);
+});
+
+test('does not sleep when only one attempt is allowed', async () => {
+  const queue = queueWith({ id: 'a' }, { id: 'b' });
+  const delays = [];
+
+  const result = await dispatch(
+    queue,
+    async (job) => {
+      if (job.id === 'a') throw new Error('once');
+      return 'ok';
+    },
+    {
+      maxAttempts: 1,
+      baseDelayMs: 100,
+      sleep: async (delayMs) => {
+        delays.push(delayMs);
+      },
+    },
+  );
+
+  assert.deepEqual(delays, []);
+  assert.equal(result.failed.length, 1);
+  assert.equal(result.failed[0].attempts, 1);
+  assert.equal(result.processed.length, 1);
+  assert.equal(result.processed[0].attempts, 1);
+  assert.equal(result.total, 2);
+});
+
+test('logs exactly one line per job at its final outcome', async () => {
+  const queue = queueWith({ id: 'retry' }, { id: 'dead' });
+  const lines = [];
+  const attemptsByJob = new Map();
+
+  await dispatch(
+    queue,
+    async (job) => {
+      const calls = (attemptsByJob.get(job.id) ?? 0) + 1;
+      attemptsByJob.set(job.id, calls);
+      if (job.id === 'dead' || calls < 2) throw new Error(`${job.id} failed`);
+      return 'ok';
+    },
+    {
+      maxAttempts: 3,
+      baseDelayMs: 1,
+      sleep: async () => {},
+      log: (line) => lines.push(line),
+    },
+  );
+
+  assert.deepEqual(lines, ['ok retry', 'fail dead: dead failed']);
+});
+
+test('rejects invalid retry options before dequeuing anything', async () => {
+  const queue = queueWith({ id: 'a' }, { id: 'b' });
+  const handler = async () => 'ok';
+
+  for (const options of [
+    { maxAttempts: 0 },
+    { maxAttempts: -1 },
+    { maxAttempts: 1.5 },
+    { baseDelayMs: -1 },
+    { baseDelayMs: 2.5 },
+  ]) {
+    await assert.rejects(
+      dispatch(queue, handler, options),
+      (error) => error instanceof RangeError,
+    );
+    assert.equal(queue.size, 2);
+  }
+});
