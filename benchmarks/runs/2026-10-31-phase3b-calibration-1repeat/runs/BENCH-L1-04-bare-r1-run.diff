+test('a bare dry-run flag validates, prints one line, and skips the queue', () => {
+  const sunk = capture();
+  const result = main(['--DRY_RUN'], {}, sunk.io);
+
+  assert.equal(result.exitCode, 0);
+  assert.deepEqual(result.config, { port: 8080, level: 'info', capacity: 100 });
+  assert.deepEqual(sunk.out, ['dry-run port=8080 level=info capacity=100']);
+  assert.deepEqual(sunk.err, []);
+  assert.equal(result.queue, undefined);
+});
+
+test('a valued dry-run flag uses the validated configuration and skips the queue', () => {
+  const sunk = capture();
+  const result = main(
+    ['--DRY_RUN=1', '--PORT=9090', '--LOG_LEVEL=warn', '--QUEUE_CAPACITY=7'],
+    {},
+    sunk.io,
+  );
+
+  assert.equal(result.exitCode, 0);
+  assert.deepEqual(result.config, { port: 9090, level: 'warn', capacity: 7 });
+  assert.deepEqual(sunk.out, ['dry-run port=9090 level=warn capacity=7']);
+  assert.deepEqual(sunk.err, []);
+  assert.equal(result.queue, undefined);
+});
+
+test('an invalid configuration under dry-run exits 2 without constructing a queue', () => {
+  const sunk = capture();
+  const result = main(['--DRY_RUN=1', '--PORT=0'], {}, sunk.io);
+
+  assert.equal(result.exitCode, 2);
+  assert.deepEqual(sunk.out, []);
+  assert.deepEqual(sunk.err, ['configuration error: PORT must be a positive integer, got: 0']);
+  assert.equal(result.queue, undefined);
+});
