@@ -1,17 +1,48 @@
-export async function dispatch(queue, handler, { log = () => {} } = {}) {
+function defaultSleep(delayMs) {
+  return new Promise((resolve) => setTimeout(resolve, delayMs));
+}
+
+export async function dispatch(
+  queue,
+  handler,
+  { log = () => {}, maxAttempts = 3, baseDelayMs = 100, sleep = defaultSleep } = {},
+) {
+  if (!Number.isInteger(maxAttempts) || maxAttempts < 1) {
+    throw new RangeError(`maxAttempts must be a positive integer, got: ${maxAttempts}`);
+  }
+  if (!Number.isInteger(baseDelayMs) || baseDelayMs < 0) {
+    throw new RangeError(`baseDelayMs must be a non-negative integer, got: ${baseDelayMs}`);
+  }
+
   const processed = [];
   const failed = [];
 
   while (queue.size > 0) {
     const job = queue.dequeue();
     const id = job && job.id !== undefined ? job.id : 'job';
-    try {
-      const result = await handler(job);
-      processed.push({ job, result });
-      log(`ok ${id}`);
-    } catch (error) {
-      failed.push({ job, error });
-      log(`fail ${id}: ${error.message}`);
+    let attempts = 0;
+    let succeeded = false;
+    let lastError;
+
+    while (attempts < maxAttempts) {
+      attempts += 1;
+      try {
+        const result = await handler(job);
+        processed.push({ job, result, attempts });
+        log(`ok ${id}`);
+        succeeded = true;
+        break;
+      } catch (error) {
+        lastError = error;
+        if (attempts < maxAttempts) {
+          await sleep(baseDelayMs * 2 ** (attempts - 1));
+        }
+      }
+    }
+
+    if (!succeeded) {
+      failed.push({ job, error: lastError, attempts });
+      log(`fail ${id}: ${lastError.message}`);
     }
   }
 
diff --git a/test/dispatcher.test.js b/test/dispatcher.test.js
index 53798d9..aeac020 100644
--- a/test/dispatcher.test.js
+++ b/test/dispatcher.test.js
@@ -60,3 +60,163 @@ test('returns empty results for an empty queue', async () => {
   assert.deepEqual(result.failed, []);
   assert.equal(result.total, 0);
 });
+
+test('retries a failing job and records the attempt count on success', async () => {
+  const queue = queueWith({ id: 'flaky' });
+  const delays = [];
+  const lines = [];
+  let calls = 0;
+
+  const result = await dispatch(
+    queue,
+    async () => {
+      calls += 1;
+      if (calls < 3) throw new Error(`boom ${calls}`);
+      return 'recovered';
+    },
+    {
+      sleep: async (ms) => {
+        delays.push(ms);
+      },
+      log: (line) => lines.push(line),
+    },
+  );
+
+  assert.equal(calls, 3);
+  assert.deepEqual(delays, [100, 200]);
+  assert.equal(result.processed.length, 1);
+  assert.equal(result.processed[0].job.id, 'flaky');
+  assert.equal(result.processed[0].result, 'recovered');
+  assert.equal(result.processed[0].attempts, 3);
+  assert.equal(result.failed.length, 0);
+  assert.equal(result.total, 1);
+  assert.deepEqual(lines, ['ok flaky']);
+});
+
+test('gives up after maxAttempts and carries the last error', async () => {
+  const queue = queueWith({ id: 'bad' });
+  const delays = [];
+  const lines = [];
+  let calls = 0;
+
+  const result = await dispatch(
+    queue,
+    async () => {
+      calls += 1;
+      throw new Error(`failure ${calls}`);
+    },
+    {
+      sleep: async (ms) => {
+        delays.push(ms);
+      },
+      log: (line) => lines.push(line),
+    },
+  );
+
+  assert.equal(calls, 3);
+  assert.deepEqual(delays, [100, 200]);
+  assert.equal(result.processed.length, 0);
+  assert.equal(result.failed.length, 1);
+  assert.equal(result.failed[0].job.id, 'bad');
+  assert.equal(result.failed[0].attempts, 3);
+  assert.match(result.failed[0].error.message, /failure 3/);
+  assert.equal(result.total, 1);
+  assert.deepEqual(lines, ['fail bad: failure 3']);
+});
+
+test('backs off exponentially from baseDelayMs between attempts', async () => {
+  const queue = queueWith({ id: 'a' }, { id: 'b' });
+  const delays = [];
+  let calls = 0;
+
+  const result = await dispatch(
+    queue,
+    async () => {
+      calls += 1;
+      throw new Error('nope');
+    },
+    {
+      maxAttempts: 4,
+      baseDelayMs: 50,
+      sleep: async (ms) => {
+        delays.push(ms);
+      },
+    },
+  );
+
+  assert.equal(calls, 8);
+  assert.deepEqual(delays, [50, 100, 200, 50, 100, 200]);
+  assert.deepEqual(
+    result.failed.map((entry) => entry.attempts),
+    [4, 4],
+  );
+});
+
+test('does not wait when baseDelayMs is zero', async () => {
+  const queue = queueWith({ id: 'a' });
+  const delays = [];
+
+  await dispatch(
+    queue,
+    async () => {
+      throw new Error('nope');
+    },
+    {
+      maxAttempts: 3,
+      baseDelayMs: 0,
+      sleep: async (ms) => {
+        delays.push(ms);
+      },
+    },
+  );
+
+  assert.deepEqual(delays, [0, 0]);
+});
+
+test('maxAttempts of 1 makes a single attempt without sleeping', async () => {
+  const queue = queueWith({ id: 'bad' });
+  const delays = [];
+  let calls = 0;
+
+  const result = await dispatch(
+    queue,
+    async () => {
+      calls += 1;
+      throw new Error('once');
+    },
+    {
+      maxAttempts: 1,
+      sleep: async (ms) => {
+        delays.push(ms);
+      },
+    },
+  );
+
+  assert.equal(calls, 1);
+  assert.deepEqual(delays, []);
+  assert.equal(result.failed[0].attempts, 1);
+  assert.equal(result.total, 1);
+});
+
+test('rejects invalid retry options before dequeuing anything', async () => {
+  for (const options of [
+    { maxAttempts: 0 },
+    { maxAttempts: -1 },
+    { maxAttempts: 1.5 },
+    { maxAttempts: '3' },
+    { baseDelayMs: -1 },
+    { baseDelayMs: 2.5 },
+    { baseDelayMs: null },
+  ]) {
+    const queue = queueWith({ id: 'a' }, { id: 'b' });
+    const lines = [];
+
+    await assert.rejects(
+      () => dispatch(queue, async () => 'ok', { ...options, log: (line) => lines.push(line) }),
+      RangeError,
+    );
+
+    assert.equal(queue.size, 2);
+    assert.deepEqual(lines, []);
+  }
+});
