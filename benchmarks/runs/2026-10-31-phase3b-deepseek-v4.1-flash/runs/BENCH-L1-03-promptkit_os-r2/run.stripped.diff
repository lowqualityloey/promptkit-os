diff --git a/test/dispatcher.test.js b/test/dispatcher.test.js
index 53798d9..2faefea 100644
--- a/test/dispatcher.test.js
+++ b/test/dispatcher.test.js
@@ -60,3 +60,35 @@ test('returns empty results for an empty queue', async () => {
   assert.deepEqual(result.failed, []);
   assert.equal(result.total, 0);
 });
+
+test('reports counts that match the processed, failed, and total lengths', async () => {
+  const queue = queueWith({ id: 'a' }, { id: 'bad' }, { id: 'c' });
+  const result = await dispatch(queue, async (job) => {
+    if (job.id === 'bad') throw new Error('handler exploded');
+    return job.id.toUpperCase();
+  });
+
+  assert.deepEqual(result.counts, { processed: 2, failed: 1, total: 3 });
+  assert.equal(result.counts.processed, result.processed.length);
+  assert.equal(result.counts.failed, result.failed.length);
+  assert.equal(result.counts.total, result.total);
+  assert.equal(
+    result.counts.total,
+    result.counts.processed + result.counts.failed,
+  );
+  for (const value of Object.values(result.counts)) {
+    assert.ok(Number.isInteger(value));
+  }
+});
+
+test('reports zeroed counts for an empty queue', async () => {
+  const result = await dispatch(createQueue(), async () => 'ok');
+
+  assert.deepEqual(result.counts, { processed: 0, failed: 0, total: 0 });
+  assert.equal(result.counts.processed, result.processed.length);
+  assert.equal(result.counts.failed, result.failed.length);
+  assert.equal(result.counts.total, result.total);
+  for (const value of Object.values(result.counts)) {
+    assert.ok(Number.isInteger(value));
+  }
+});
