+test('enqueueMany appends items in order and returns the new size', () => {
+  const queue = createQueue({ capacity: 5 });
+  queue.enqueue('a');
+
+  assert.equal(queue.enqueueMany(['b', 'c', 'd']), 4);
+  assert.equal(queue.size, 4);
+  assert.deepEqual(queue.drain(), ['a', 'b', 'c', 'd']);
+});
+
+test('enqueueMany throws and leaves the queue untouched when items do not all fit', () => {
+  const queue = createQueue({ capacity: 3 });
+  queue.enqueue('a');
+  queue.enqueue('b');
+
+  assert.throws(
+    () => queue.enqueueMany(['c', 'd']),
+    (error) => error instanceof QueueFullError && error.capacity === 3,
+  );
+  assert.equal(queue.size, 2);
+  assert.equal(queue.dequeue(), 'a');
+  assert.equal(queue.dequeue(), 'b');
+  assert.equal(queue.size, 0);
+});
+
+test('enqueueMany with an empty array is a no-op returning the current size', () => {
+  const empty = createQueue({ capacity: 2 });
+  assert.equal(empty.enqueueMany([]), 0);
+  assert.equal(empty.size, 0);
+
+  const full = createQueue({ capacity: 1 });
+  full.enqueue('only');
+  assert.equal(full.enqueueMany([]), 1);
+  assert.equal(full.size, 1);
+  assert.equal(full.dequeue(), 'only');
+});
+
