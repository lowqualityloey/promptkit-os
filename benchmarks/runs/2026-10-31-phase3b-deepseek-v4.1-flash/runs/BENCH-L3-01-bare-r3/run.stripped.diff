+const defaultSleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
+
+export async function dispatch(
+  queue,
+  handler,
+  { log = () => {}, maxAttempts = 3, baseDelayMs = 100, sleep = defaultSleep } = {},
+) {
+  if (!Number.isInteger(maxAttempts) || maxAttempts < 1) {
+    throw new RangeError(`maxAttempts must be a positive integer, got: ${maxAttempts}`);
+  }
+  if (!Number.isInteger(baseDelayMs) || baseDelayMs < 0) {
+    throw new RangeError(`baseDelayMs must be a non-negative integer, got: ${baseDelayMs}`);
+  }
+
   const processed = [];
   const failed = [];
 
   while (queue.size > 0) {
     const job = queue.dequeue();
     const id = job && job.id !== undefined ? job.id : 'job';
-    try {
-      const result = await handler(job);
-      processed.push({ job, result });
-      log(`ok ${id}`);
-    } catch (error) {
-      failed.push({ job, error });
-      log(`fail ${id}: ${error.message}`);
+    let attempts = 0;
+    let lastError;
+    let succeeded = false;
+
+    while (!succeeded) {
+      attempts += 1;
+      try {
+        const result = await handler(job);
+        processed.push({ job, result, attempts });
+        log(`ok ${id}`);
+        succeeded = true;
+      } catch (error) {
+        lastError = error;
+        if (attempts >= maxAttempts) break;
+        await sleep(baseDelayMs * 2 ** (attempts - 1));
+      }
+    }
+
+    if (!succeeded) {
+      failed.push({ job, error: lastError, attempts });
+      log(`fail ${id}: ${lastError.message}`);
     }
   }
 
diff --git a/test/dispatcher.test.js b/test/dispatcher.test.js
index 53798d9..ca6ab1b 100644
--- a/test/dispatcher.test.js
+++ b/test/dispatcher.test.js
@@ -60,3 +60,93 @@ test('returns empty results for an empty queue', async () => {
   assert.deepEqual(result.failed, []);
   assert.equal(result.total, 0);
 });
+
+test('retries a failing job and records it once when it later succeeds', async () => {
+  const queue = queueWith({ id: 'flaky' });
+  const delays = [];
+  const attemptsSeen = [];
+  const lines = [];
+
+  const result = await dispatch(
+    queue,
+    async () => {
+      attemptsSeen.push(attemptsSeen.length + 1);
+      if (attemptsSeen.length < 3) throw new Error(`attempt ${attemptsSeen.length} failed`);
+      return 'recovered';
+    },
+    {
+      sleep: async (ms) => {
+        delays.push(ms);
+      },
+      log: (line) => lines.push(line),
+    },
+  );
+
+  assert.deepEqual(attemptsSeen, [1, 2, 3]);
+  assert.deepEqual(delays, [100, 200]);
+  assert.equal(result.processed.length, 1);
+  assert.equal(result.processed[0].result, 'recovered');
+  assert.equal(result.processed[0].attempts, 3);
+  assert.equal(result.failed.length, 0);
+  assert.equal(result.total, 1);
+  assert.deepEqual(lines, ['ok flaky']);
+});
+
+test('exhausts maxAttempts and records the last error once', async () => {
+  const queue = queueWith({ id: 'bad' });
+  const delays = [];
+  const lines = [];
+  let calls = 0;
+
+  const result = await dispatch(
+    queue,
+    async () => {
+      calls += 1;
+      throw new Error(`boom ${calls}`);
+    },
+    {
+      maxAttempts: 3,
+      sleep: async (ms) => {
+        delays.push(ms);
+      },
+      log: (line) => lines.push(line),
+    },
+  );
+
+  assert.equal(calls, 3);
+  assert.deepEqual(delays, [100, 200]);
+  assert.equal(result.processed.length, 0);
+  assert.equal(result.failed.length, 1);
+  assert.equal(result.failed[0].job.id, 'bad');
+  assert.equal(result.failed[0].attempts, 3);
+  assert.match(result.failed[0].error.message, /boom 3/);
+  assert.equal(result.total, 1);
+  assert.deepEqual(lines, ['fail bad: boom 3']);
+});
+
+test('backs off exponentially from baseDelayMs between attempts', async () => {
+  const queue = queueWith({ id: 'bad' });
+  const delays = [];
+
+  const result = await dispatch(queue, async () => {
+    throw new Error('nope');
+  }, {
+    maxAttempts: 4,
+    baseDelayMs: 25,
+    sleep: async (ms) => {
+      delays.push(ms);
+    },
+  });
+
+  assert.deepEqual(delays, [25, 50, 100]);
+  assert.equal(result.failed[0].attempts, 4);
+});
+
+test('rejects invalid retry options before dequeuing', async () => {
+  const queue = queueWith({ id: 'a' });
+
+  await assert.rejects(dispatch(queue, async () => 'ok', { maxAttempts: 0 }), RangeError);
+  assert.equal(queue.size, 1);
+  await assert.rejects(dispatch(queue, async () => 'ok', { baseDelayMs: -1 }), RangeError);
+  assert.equal(queue.size, 1);
+});
