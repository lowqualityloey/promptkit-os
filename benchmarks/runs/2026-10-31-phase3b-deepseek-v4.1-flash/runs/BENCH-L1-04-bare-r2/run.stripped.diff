     const queue = createQueue({ capacity: config.capacity });
     io.out(`ready port=${config.port} level=${config.level} capacity=${config.capacity}`);
     return { exitCode: 0, config, queue };
diff --git a/test/app.test.js b/test/app.test.js
index f0779f3..dbc269e 100644
--- a/test/app.test.js
+++ b/test/app.test.js
@@ -80,3 +80,34 @@ test('parseFlags returns the parsed pairs', () => {
     LOG_LEVEL: 'warn',
   });
 });
+
+test('a dry run validates, prints one dry-run line, and skips the queue', () => {
+  const sunk = capture();
+  const result = main(['--DRY_RUN=1', '--PORT=9090'], { QUEUE_CAPACITY: '7' }, sunk.io);
+
+  assert.equal(result.exitCode, 0);
+  assert.equal(result.queue, undefined);
+  assert.deepEqual(result.config, { port: 9090, level: 'info', capacity: 7 });
+  assert.deepEqual(sunk.out, ['dry-run port=9090 level=info capacity=7']);
+  assert.deepEqual(sunk.err, []);
+});
+
+test('a bare dry-run flag counts as present', () => {
+  const sunk = capture();
+  const result = main(['--DRY_RUN'], {}, sunk.io);
+
+  assert.equal(result.exitCode, 0);
+  assert.equal(result.queue, undefined);
+  assert.deepEqual(sunk.out, ['dry-run port=8080 level=info capacity=100']);
+  assert.deepEqual(sunk.err, []);
+});
+
+test('an invalid configuration under dry run exits 2 and skips the queue', () => {
+  const sunk = capture();
+  const result = main(['--DRY_RUN=1', '--PORT=0'], {}, sunk.io);
+
+  assert.equal(result.exitCode, 2);
+  assert.equal(result.queue, undefined);
+  assert.deepEqual(sunk.out, []);
+  assert.match(sunk.err[0], /configuration error: PORT must be a positive integer/);
+});
