diff --git a/test/config.test.js b/test/config.test.js
index 5ec8d49..e204f8e 100644
--- a/test/config.test.js
+++ b/test/config.test.js
@@ -46,6 +46,27 @@ test('rejects a non-positive capacity', () => {
   assert.throws(() => loadConfig({ QUEUE_CAPACITY: '0' }), ConfigError);
 });
 
+test('accepts an unbounded capacity case-insensitively', () => {
+  for (const raw of ['unbounded', 'UNBOUNDED', 'Unbounded']) {
+    assert.equal(loadConfig({ QUEUE_CAPACITY: raw }).capacity, Number.POSITIVE_INFINITY, raw);
+  }
+});
+
+test('still defaults to 100 when the capacity is absent or empty', () => {
+  assert.equal(loadConfig({}).capacity, 100);
+  assert.equal(loadConfig({ QUEUE_CAPACITY: '' }).capacity, 100);
+});
+
+test('rejects zero, negative, fractional, and non-numeric capacities', () => {
+  for (const raw of ['0', '-1', '-0', '1.5', 'abc', 'Infinity']) {
+    assert.throws(() => loadConfig({ QUEUE_CAPACITY: raw }), ConfigError, `QUEUE_CAPACITY=${raw}`);
+  }
+});
+
+test('leaves the unbounded keyword invalid for PORT', () => {
+  assert.throws(() => loadConfig({ PORT: 'unbounded' }), ConfigError);
+});
+
 test('returns a frozen configuration object', () => {
   const config = loadConfig({});
   assert.ok(Object.isFrozen(config));
diff --git a/test/queue.test.js b/test/queue.test.js
index 1c5b0d9..6e6ed43 100644
--- a/test/queue.test.js
+++ b/test/queue.test.js
@@ -61,3 +61,31 @@ test('rejects a capacity below one', () => {
   assert.throws(() => createQueue({ capacity: 0 }), RangeError);
   assert.throws(() => createQueue({ capacity: -5 }), RangeError);
 });
+
+test('accepts an unbounded capacity', () => {
+  const queue = createQueue({ capacity: Number.POSITIVE_INFINITY });
+  assert.equal(queue.capacity, Number.POSITIVE_INFINITY);
+});
+
+test('never fills or throws when the capacity is unbounded', () => {
+  const queue = createQueue({ capacity: Number.POSITIVE_INFINITY });
+
+  assert.equal(queue.isFull, false);
+  for (let i = 0; i < 1000; i += 1) {
+    queue.enqueue(i);
+    assert.equal(queue.size, i + 1);
+    assert.equal(queue.isFull, false);
+  }
+
+  assert.equal(queue.dequeue(), 0);
+  assert.equal(queue.size, 999);
+  assert.equal(queue.drain().length, 999);
+  assert.equal(queue.size, 0);
+  assert.equal(queue.isFull, false);
+});
+
+test('still rejects other non-integer capacities', () => {
+  assert.throws(() => createQueue({ capacity: Number.NEGATIVE_INFINITY }), RangeError);
+  assert.throws(() => createQueue({ capacity: Number.NaN }), RangeError);
+  assert.throws(() => createQueue({ capacity: 1.5 }), RangeError);
+});
