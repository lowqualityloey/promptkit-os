+test('enqueueMany appends every item in order and returns the new size', () => {
+  const queue = createQueue({ capacity: 4 });
+  queue.enqueue('first');
+
+  assert.equal(queue.enqueueMany(['a', 'b', 'c']), 4);
+  assert.equal(queue.size, 4);
+  assert.equal(queue.dequeue(), 'first');
+  assert.equal(queue.dequeue(), 'a');
+  assert.equal(queue.dequeue(), 'b');
+  assert.equal(queue.dequeue(), 'c');
+});
+
+test('enqueueMany throws without partially appending when the batch does not fit', () => {
+  const queue = createQueue({ capacity: 3 });
+  queue.enqueue('head');
+  queue.enqueue('second');
+
+  assert.throws(
+    () => queue.enqueueMany(['a', 'b']),
+    (error) => error instanceof QueueFullError && error.capacity === 3,
+  );
+  assert.equal(queue.size, 2);
+  assert.equal(queue.dequeue(), 'head');
+  assert.equal(queue.dequeue(), 'second');
+  assert.equal(queue.size, 0);
+});
+
+test('enqueueMany with an empty array is a no-op that returns the current size', () => {
+  const queue = createQueue({ capacity: 2 });
+  assert.equal(queue.enqueueMany([]), 0);
+
+  queue.enqueue('a');
+  assert.equal(queue.enqueueMany([]), 1);
+  assert.equal(queue.size, 1);
+  assert.equal(queue.dequeue(), 'a');
+});
+
