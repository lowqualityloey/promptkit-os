diff --git a/test/queue.test.js b/test/queue.test.js
index 1c5b0d9..fb1e732 100644
--- a/test/queue.test.js
+++ b/test/queue.test.js
@@ -57,6 +57,40 @@ test('drain empties the queue and returns the items in order', () => {
   assert.equal(queue.size, 0);
 });
 
+test('enqueueMany appends every item in order and returns the new size', () => {
+  const queue = createQueue({ capacity: 5 });
+  queue.enqueue('a');
+
+  assert.equal(queue.enqueueMany(['b', 'c']), 3);
+  assert.equal(queue.size, 3);
+  assert.deepEqual(queue.drain(), ['a', 'b', 'c']);
+});
+
+test('enqueueMany throws QueueFullError without a partial append when they do not all fit', () => {
+  const queue = createQueue({ capacity: 3 });
+  queue.enqueue('a');
+
+  assert.throws(
+    () => queue.enqueueMany(['b', 'c', 'd']),
+    (error) => error instanceof QueueFullError && error.capacity === 3,
+  );
+  assert.equal(queue.size, 1);
+  assert.equal(queue.dequeue(), 'a');
+  assert.equal(queue.size, 0);
+});
+
+test('enqueueMany with an empty array is a no-op that returns the current size', () => {
+  const queue = createQueue({ capacity: 2 });
+  queue.enqueue('a');
+
+  assert.equal(queue.enqueueMany([]), 1);
+  assert.equal(queue.size, 1);
+
+  const empty = createQueue();
+  assert.equal(empty.enqueueMany([]), 0);
+  assert.equal(empty.size, 0);
+});
+
 test('rejects a capacity below one', () => {
