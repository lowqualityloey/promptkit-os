diff --git a/test/dispatcher.test.js b/test/dispatcher.test.js
index 53798d9..e724d28 100644
--- a/test/dispatcher.test.js
+++ b/test/dispatcher.test.js
@@ -60,3 +60,130 @@ test('returns empty results for an empty queue', async () => {
   assert.deepEqual(result.failed, []);
   assert.equal(result.total, 0);
 });
+
+test('retries a failing job and records it once in processed', async () => {
+  const queue = queueWith({ id: 'flaky' });
+  const sleeps = [];
+  const lines = [];
+  let calls = 0;
+
+  const result = await dispatch(
+    queue,
+    async () => {
+      calls += 1;
+      if (calls < 3) throw new Error(`boom ${calls}`);
+      return 'done';
+    },
+    {
+      log: (line) => lines.push(line),
+      sleep: async (delayMs) => {
+        sleeps.push(delayMs);
+      },
+    },
+  );
+
+  assert.equal(calls, 3);
+  assert.deepEqual(sleeps, [100, 200]);
+  assert.equal(result.processed.length, 1);
+  assert.equal(result.processed[0].result, 'done');
+  assert.equal(result.processed[0].attempts, 3);
+  assert.equal(result.failed.length, 0);
+  assert.equal(result.total, 1);
+  assert.deepEqual(lines, ['ok flaky']);
+});
+
+test('records an exhausted job once in failed with its last error', async () => {
+  const queue = queueWith({ id: 'bad' });
+  const sleeps = [];
+  const lines = [];
+  let calls = 0;
+
+  const result = await dispatch(
+    queue,
+    async () => {
+      calls += 1;
+      throw new Error(`boom ${calls}`);
+    },
+    {
+      log: (line) => lines.push(line),
+      sleep: async (delayMs) => {
+        sleeps.push(delayMs);
+      },
+    },
+  );
+
+  assert.equal(calls, 3);
+  assert.deepEqual(sleeps, [100, 200]);
+  assert.equal(result.failed.length, 1);
+  assert.equal(result.failed[0].job.id, 'bad');
+  assert.equal(result.failed[0].error.message, 'boom 3');
+  assert.equal(result.failed[0].attempts, 3);
+  assert.equal(result.processed.length, 0);
+  assert.equal(result.total, 1);
+  assert.deepEqual(lines, ['fail bad: boom 3']);
+});
+
+test('backs off exponentially from baseDelayMs between attempts', async () => {
+  const queue = queueWith({ id: 'bad' });
+  const sleeps = [];
+
+  await dispatch(
+    queue,
+    async () => {
+      throw new Error('nope');
+    },
+    {
+      maxAttempts: 4,
+      baseDelayMs: 50,
+      sleep: async (delayMs) => {
+        sleeps.push(delayMs);
+      },
+    },
+  );
+
+  assert.deepEqual(sleeps, [50, 100, 200]);
+});
+
+test('maxAttempts of 1 never retries or sleeps', async () => {
+  const queue = queueWith({ id: 'a' });
+  const sleeps = [];
+  let calls = 0;
+
+  const result = await dispatch(
+    queue,
+    async () => {
+      calls += 1;
+      throw new Error('once');
+    },
+    {
+      maxAttempts: 1,
+      sleep: async (delayMs) => {
+        sleeps.push(delayMs);
+      },
+    },
+  );
+
+  assert.equal(calls, 1);
+  assert.deepEqual(sleeps, []);
+  assert.equal(result.failed.length, 1);
+  assert.equal(result.failed[0].attempts, 1);
+});
+
+test('rejects invalid retry options before dequeuing', async () => {
+  for (const options of [
+    { maxAttempts: 0 },
+    { maxAttempts: -1 },
+    { maxAttempts: 1.5 },
+    { maxAttempts: '3' },
+    { baseDelayMs: -1 },
+    { baseDelayMs: 1.5 },
+    { baseDelayMs: '100' },
+  ]) {
+    const queue = queueWith({ id: 'a' }, { id: 'b' });
+    await assert.rejects(
+      dispatch(queue, async () => 'ok', options),
+      RangeError,
+    );
+    assert.equal(queue.size, 2);
+  }
+});
