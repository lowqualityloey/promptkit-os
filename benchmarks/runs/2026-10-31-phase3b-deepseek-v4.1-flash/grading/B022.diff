+export async function dispatch(
+  queue,
+  handler,
+  {
+    log = () => {},
+    maxAttempts = 3,
+    baseDelayMs = 100,
+    sleep = defaultSleep,
+  } = {},
+) {
+  if (!Number.isInteger(maxAttempts) || maxAttempts < 1) {
+    throw new RangeError(`maxAttempts must be a positive integer, got: ${maxAttempts}`);
+  }
+  if (!Number.isInteger(baseDelayMs) || baseDelayMs < 0) {
+    throw new RangeError(`baseDelayMs must be a non-negative integer, got: ${baseDelayMs}`);
+  }
+
   const processed = [];
   const failed = [];
 
   while (queue.size > 0) {
     const job = queue.dequeue();
     const id = job && job.id !== undefined ? job.id : 'job';
-    try {
-      const result = await handler(job);
-      processed.push({ job, result });
-      log(`ok ${id}`);
-    } catch (error) {
-      failed.push({ job, error });
-      log(`fail ${id}: ${error.message}`);
+
+    let attempts = 0;
+    for (;;) {
+      attempts += 1;
+      try {
+        const result = await handler(job);
+        processed.push({ job, result, attempts });
+        log(`ok ${id}`);
+        break;
+      } catch (error) {
+        if (attempts >= maxAttempts) {
+          failed.push({ job, error, attempts });
