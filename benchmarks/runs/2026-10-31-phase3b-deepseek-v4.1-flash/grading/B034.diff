-export async function dispatch(queue, handler, { log = () => {} } = {}) {
+export async function dispatch(
+  queue,
+  handler,
+  {
+    log = () => {},
+    maxAttempts = 3,
+    baseDelayMs = 100,
+    sleep = (delayMs) => new Promise((resolve) => setTimeout(resolve, delayMs)),
+  } = {},
+) {
+  if (!Number.isInteger(maxAttempts) || maxAttempts < 1) {
+    throw new RangeError(`maxAttempts must be a positive integer, got: ${maxAttempts}`);
+  }
+  if (!Number.isInteger(baseDelayMs) || baseDelayMs < 0) {
+    throw new RangeError(`baseDelayMs must be a non-negative integer, got: ${baseDelayMs}`);
+  }
+
   const processed = [];
   const failed = [];
 
   while (queue.size > 0) {
     const job = queue.dequeue();
     const id = job && job.id !== undefined ? job.id : 'job';
-    try {
-      const result = await handler(job);
-      processed.push({ job, result });
-      log(`ok ${id}`);
-    } catch (error) {
-      failed.push({ job, error });
-      log(`fail ${id}: ${error.message}`);
+
+    let attempts = 0;
+    for (;;) {
+      attempts += 1;
+      try {
+        const result = await handler(job);
+        processed.push({ job, result, attempts });
+        log(`ok ${id}`);
+        break;
+      } catch (error) {
+        if (attempts >= maxAttempts) {
+          failed.push({ job, error, attempts });
+          log(`fail ${id}: ${error.message}`);
+          break;
+        }
+        await sleep(baseDelayMs * 2 ** (attempts - 1));
+      }
     }
   }
 
diff --git a/test/dispatcher.test.js b/test/dispatcher.test.js
index 53798d9..bbbca26 100644
--- a/test/dispatcher.test.js
+++ b/test/dispatcher.test.js
@@ -60,3 +60,93 @@ test('returns empty results for an empty queue', async () => {
   assert.deepEqual(result.failed, []);
   assert.equal(result.total, 0);
 });
+
+test('retries a failing job and records it once in processed when it succeeds', async () => {
+  const queue = queueWith({ id: 'flaky' });
+  const delays = [];
+  const lines = [];
+  let calls = 0;
+
+  const result = await dispatch(
+    queue,
+    async () => {
+      calls += 1;
+      if (calls < 3) throw new Error('try again');
+      return 'recovered';
+    },
+    { sleep: async (ms) => delays.push(ms), log: (line) => lines.push(line) },
+  );
+
+  assert.equal(calls, 3);
+  assert.deepEqual(delays, [100, 200]);
+  assert.equal(result.processed.length, 1);
+  assert.equal(result.processed[0].result, 'recovered');
+  assert.equal(result.processed[0].attempts, 3);
+  assert.equal(result.failed.length, 0);
+  assert.equal(result.total, 1);
+  assert.deepEqual(lines, ['ok flaky']);
+});
+
+test('fails a job once after exhausting its attempts and keeps the last error', async () => {
+  const queue = queueWith({ id: 'doomed' });
+  const delays = [];
+  const lines = [];
+  let calls = 0;
+
+  const result = await dispatch(
+    queue,
+    async () => {
+      calls += 1;
+      throw new Error(`boom ${calls}`);
+    },
+    {
+      maxAttempts: 4,
+      sleep: async (ms) => delays.push(ms),
+      log: (line) => lines.push(line),
+    },
+  );
+
+  assert.equal(calls, 4);
+  assert.deepEqual(delays, [100, 200, 400]);
+  assert.equal(result.processed.length, 0);
+  assert.equal(result.failed.length, 1);
+  assert.equal(result.failed[0].job.id, 'doomed');
+  assert.equal(result.failed[0].attempts, 4);
+  assert.match(result.failed[0].error.message, /boom 4/);
+  assert.equal(result.total, 1);
+  assert.deepEqual(lines, ['fail doomed: boom 4']);
+});
+
+test('backs off exponentially from baseDelayMs across multiple jobs', async () => {
+  const queue = queueWith({ id: 'a' }, { id: 'b' });
+  const delays = [];
+
+  const result = await dispatch(
+    queue,
+    async () => {
+      throw new Error('nope');
+    },
+    { maxAttempts: 3, baseDelayMs: 50, sleep: async (ms) => delays.push(ms) },
+  );
+
+  assert.deepEqual(delays, [50, 100, 50, 100]);
+  assert.deepEqual(
+    result.failed.map((entry) => entry.attempts),
+    [3, 3],
+  );
+  assert.equal(result.total, 2);
+});
+
+test('rejects invalid retry options before dequeuing', async () => {
+  const queue = queueWith({ id: 'a' });
+
+  await assert.rejects(
+    dispatch(queue, async () => 'ok', { maxAttempts: 0, sleep: async () => {} }),
+    RangeError,
+  );
+  await assert.rejects(
+    dispatch(queue, async () => 'ok', { baseDelayMs: -1, sleep: async () => {} }),
+    RangeError,
+  );
+  assert.equal(queue.size, 1);
+});
