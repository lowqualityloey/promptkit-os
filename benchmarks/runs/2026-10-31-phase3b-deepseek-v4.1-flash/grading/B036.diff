+test('retries a failing job and records the attempt that succeeded', async () => {
+  const queue = queueWith({ id: 'flaky' });
+  const attempts = [];
+  const lines = [];
+  const result = await dispatch(
+    queue,
+    async (job) => {
+      attempts.push(job.id);
+      if (attempts.length < 3) throw new Error('transient');
+      return 'recovered';
+    },
+    { sleep: async () => {}, log: (line) => lines.push(line) },
+  );
+
+  assert.equal(attempts.length, 3);
+  assert.equal(result.processed.length, 1);
+  assert.equal(result.processed[0].result, 'recovered');
+  assert.equal(result.processed[0].attempts, 3);
+  assert.equal(result.failed.length, 0);
+  assert.equal(result.total, 1);
+  assert.deepEqual(lines, ['ok flaky']);
+});
+
+test('exhausts maxAttempts and records the last error once', async () => {
+  const queue = queueWith({ id: 'doomed' });
+  let calls = 0;
+  const lines = [];
+  const result = await dispatch(
+    queue,
+    async () => {
+      calls += 1;
+      throw new Error(`boom ${calls}`);
+    },
+    { maxAttempts: 3, sleep: async () => {}, log: (line) => lines.push(line) },
+  );
+
+  assert.equal(calls, 3);
+  assert.equal(result.processed.length, 0);
+  assert.equal(result.failed.length, 1);
+  assert.equal(result.failed[0].job.id, 'doomed');
+  assert.equal(result.failed[0].attempts, 3);
+  assert.equal(result.failed[0].error.message, 'boom 3');
+  assert.equal(result.total, 1);
+  assert.deepEqual(lines, ['fail doomed: boom 3']);
+});
+
+test('backs off exponentially between attempts', async () => {
+  const queue = queueWith({ id: 'slow-fail' });
+  const delays = [];
+  await dispatch(queue, async () => { throw new Error('nope'); }, {
+    maxAttempts: 4,
+    baseDelayMs: 100,
+    sleep: async (delayMs) => { delays.push(delayMs); },
+  });
+
+  assert.deepEqual(delays, [100, 200, 400]);
+});
+
+test('does not sleep after the final failed attempt', async () => {
+  const queue = queueWith({ id: 'only' });
+  const delays = [];
+  await dispatch(queue, async () => { throw new Error('nope'); }, {
+    maxAttempts: 1,
+    sleep: async (delayMs) => { delays.push(delayMs); },
+  });
+
+  assert.deepEqual(delays, []);
+});
+
+test('rejects an invalid maxAttempts before dequeuing', async () => {
+  const queue = queueWith({ id: 'a' }, { id: 'b' });
+  await assert.rejects(
+    dispatch(queue, async () => 'ok', { maxAttempts: 0 }),
+    RangeError,
+  );
+  assert.equal(queue.size, 2);
+});
+
+test('rejects an invalid baseDelayMs before dequeuing', async () => {
+  const queue = queueWith({ id: 'a' }, { id: 'b' });
+  await assert.rejects(
+    dispatch(queue, async () => 'ok', { baseDelayMs: -1 }),
+    RangeError,
+  );
+  assert.equal(queue.size, 2);
+});
+
