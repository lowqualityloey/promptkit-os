+
+  assert.equal(queue.peek(), undefined);
+
+  queue.enqueue('a');
+  queue.enqueue('b');
+
+  assert.equal(queue.peek(), 'a');
+  assert.equal(queue.size, 2);
+  assert.equal(queue.dequeue(), 'a');
