diff --git a/test/dispatcher.test.js b/test/dispatcher.test.js
index 53798d9..a931e75 100644
--- a/test/dispatcher.test.js
+++ b/test/dispatcher.test.js
@@ -60,3 +60,119 @@ test('returns empty results for an empty queue', async () => {
   assert.deepEqual(result.failed, []);
   assert.equal(result.total, 0);
 });
+
+test('retries a failing handler and records one success with its attempt count', async () => {
+  const queue = queueWith({ id: 'flaky' }, { id: 'steady' });
+  const lines = [];
+  const calls = [];
+  const result = await dispatch(
+    queue,
+    async (job) => {
+      calls.push(job.id);
+      if (job.id === 'flaky' && calls.filter((id) => id === 'flaky').length < 3) {
+        throw new Error('transient');
+      }
+      return `${job.id}-ok`;
+    },
+    { sleep: async () => {}, log: (line) => lines.push(line) },
+  );
+
+  assert.deepEqual(calls, ['flaky', 'flaky', 'flaky', 'steady']);
+  assert.equal(result.total, 2);
+  assert.equal(result.failed.length, 0);
+  assert.equal(result.processed.length, 2);
+
+  const flaky = result.processed.find((entry) => entry.job.id === 'flaky');
+  assert.equal(flaky.result, 'flaky-ok');
+  assert.equal(flaky.attempts, 3);
+
+  const steady = result.processed.find((entry) => entry.job.id === 'steady');
+  assert.equal(steady.result, 'steady-ok');
+  assert.equal(steady.attempts, 1);
+
+  assert.deepEqual(lines, ['ok flaky', 'ok steady']);
+});
+
+test('exhausts every attempt and records the last error', async () => {
+  const queue = queueWith({ id: 'bad' });
+  let calls = 0;
+  const lines = [];
+  const result = await dispatch(
+    queue,
+    async () => {
+      calls += 1;
+      throw new Error(`attempt ${calls}`);
+    },
+    { maxAttempts: 3, sleep: async () => {}, log: (line) => lines.push(line) },
+  );
+
+  assert.equal(calls, 3);
+  assert.equal(result.failed.length, 1);
+  assert.equal(result.failed[0].job.id, 'bad');
+  assert.equal(result.failed[0].attempts, 3);
+  assert.match(result.failed[0].error.message, /attempt 3/);
+  assert.equal(result.processed.length, 0);
+  assert.equal(result.total, 1);
+  assert.deepEqual(lines, ['fail bad: attempt 3']);
+});
+
+test('waits with exponential backoff between attempts', async () => {
+  const queue = queueWith({ id: 'bad' });
+  const delays = [];
+  await dispatch(
+    queue,
+    async () => {
+      throw new Error('nope');
+    },
+    {
+      maxAttempts: 4,
+      baseDelayMs: 100,
+      sleep: async (delayMs) => {
+        delays.push(delayMs);
+      },
+    },
+  );
+
+  assert.deepEqual(delays, [100, 200, 400]);
+});
+
+test('does not sleep when maxAttempts is 1', async () => {
+  const queue = queueWith({ id: 'bad' });
+  let calls = 0;
+  let slept = false;
+  const result = await dispatch(
+    queue,
+    async () => {
+      calls += 1;
+      throw new Error('nope');
+    },
+    {
+      maxAttempts: 1,
+      sleep: async () => {
+        slept = true;
+      },
+    },
+  );
+
+  assert.equal(calls, 1);
+  assert.equal(slept, false);
+  assert.equal(result.failed[0].attempts, 1);
+  assert.equal(result.total, 1);
+});
+
+test('rejects invalid retry options before dequeuing anything', async () => {
+  const queue = queueWith({ id: 'a' }, { id: 'b' });
+  const handler = async () => 'ok';
+
+  await assert.rejects(dispatch(queue, handler, { maxAttempts: 0 }), RangeError);
+  assert.equal(queue.size, 2);
+
+  await assert.rejects(dispatch(queue, handler, { maxAttempts: 1.5 }), RangeError);
+  assert.equal(queue.size, 2);
+
+  await assert.rejects(dispatch(queue, handler, { baseDelayMs: -1 }), RangeError);
+  assert.equal(queue.size, 2);
+
+  await assert.rejects(dispatch(queue, handler, { baseDelayMs: 2.5 }), RangeError);
+  assert.equal(queue.size, 2);
+});
