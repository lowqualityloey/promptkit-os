+test('caps the backoff schedule at jitterCapMs', async () => {
+  const queue = queueWith('doomed');
+  const delays = [];
+  let draws = 0;
+
+  await dispatch(
+    queue,
+    async () => {
+      throw new Error('nope');
+    },
+    {
+      maxAttempts: 4,
+      baseDelayMs: 100,
+      jitterCapMs: 150,
+      jitter: () => {
+        draws += 1;
+        return 0.9;
+      },
+      sleep: async (delayMs) => {
+        delays.push(delayMs);
+      },
+    },
+  );
+
+  assert.deepEqual(delays, [90, 135, 135]);
+  assert.equal(draws, delays.length);
+  assert.ok(delays.every((delayMs) => delayMs <= 150));
+});
