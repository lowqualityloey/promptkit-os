+test('status counts a closed job as done and an open job as pending', () => {
+  const { runner } = runnerOn([
+    { type: 'enqueue', id: 'finished', at: 1 },
+    { type: 'done', id: 'finished', at: 2 },
+    { type: 'enqueue', id: 'open', at: 3 },
+  ]);
+
+  const counts = runner.status();
+  assert.equal(counts.pending, 1);
+  assert.equal(counts.done, 1);
+  assert.equal(counts.failed, 0);
+  assert.equal(counts.pending + counts.done + counts.failed, 2);
+});
+
+test('status counts a failed job as failed, not pending', () => {
+  const { runner } = runnerOn([
+    { type: 'enqueue', id: 'bad', at: 1 },
+    { type: 'failed', id: 'bad', at: 2 },
+  ]);
+
+  const counts = runner.status();
+  assert.equal(counts.pending, 0);
+  assert.equal(counts.failed, 1);
+  assert.equal(counts.pending + counts.done + counts.failed, 1);
+});
+
