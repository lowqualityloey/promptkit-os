+test('intake skips a finished job and accepts an unfinished one across a restart', async () => {
+  const { io, runner } = runnerOn([
+    { type: 'enqueue', id: 'finished', at: 1 },
+    { type: 'done', id: 'finished', at: 2 },
+    { type: 'enqueue', id: 'unfinished', at: 3 },
+  ]);
+  const ran = [];
+  const handler = async (job) => {
+    ran.push(job.id);
+    return job.id;
+  };
+
+  await runner.enqueue(['finished', 'unfinished']);
+  await runner.run(handler);
+  assert.deepEqual(ran, ['unfinished']);
+
+  await runner.enqueue(['finished', 'unfinished']);
+  await runner.run(handler);
+  assert.deepEqual(ran, ['unfinished']);
+
+  const records = io
+    .readFileSync('jobs.jsonl')
+    .split('\n')
+    .filter(Boolean)
+    .map((line) => JSON.parse(line));
+  assert.equal(records.filter((record) => record.id === 'finished').length, 2);
+  assert.equal(
+    records.filter((record) => record.type === 'enqueue' && record.id === 'unfinished').length,
+    1,
+  );
+  assert.equal(records.filter((record) => record.type === 'done' && record.id === 'unfinished').length, 1);
+});
+
 test('main prints a dry-run line and returns without touching the store', async () => {
