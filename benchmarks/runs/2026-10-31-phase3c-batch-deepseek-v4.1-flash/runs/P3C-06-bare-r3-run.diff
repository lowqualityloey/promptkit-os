+test('reports counts alongside the result lists', async () => {
+  const queue = queueWith('a', 'bad');
+  const result = await dispatch(
+    queue,
+    async (job) => {
+      if (job.id === 'bad') throw new Error('nope');
+      return 'ok';
+    },
+    { maxAttempts: 1, sleep: async () => {} },
+  );
+
+  assert.deepEqual(result.counts, { processed: 1, failed: 1, total: 2 });
+  assert.equal(result.counts.processed, result.processed.length);
+  assert.equal(result.counts.failed, result.failed.length);
+  assert.equal(result.counts.total, result.total);
+  assert.ok(Number.isInteger(result.counts.processed));
+  assert.ok(Number.isInteger(result.counts.failed));
+  assert.ok(Number.isInteger(result.counts.total));
+});
+
+test('counts one job per job, not per attempt', async () => {
+  const queue = queueWith('flaky');
+  const result = await dispatch(
+    queue,
+    async () => {
+      throw new Error('always');
+    },
+    { maxAttempts: 3, sleep: async () => {} },
+  );
+
+  assert.equal(result.counts.processed, 0);
+  assert.equal(result.counts.failed, 1);
+  assert.equal(result.counts.total, 1);
+});
+
