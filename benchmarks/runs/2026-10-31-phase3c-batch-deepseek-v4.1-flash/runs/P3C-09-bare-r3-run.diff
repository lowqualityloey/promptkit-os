@@ -0,0 +1,83 @@
+import test from 'node:test';
+import assert from 'node:assert';
+
+import { BackpressureError, createRunner } from '../src/app.js';
+import { QueueFullError, createQueue } from '../src/queue.js';
+
+function storeThatRejectsAfter(accepted) {
+  const written = [];
+  let calls = 0;
+  return {
+    written,
+    append(record) {
+      calls += 1;
+      if (calls > accepted) throw new Error('store is unavailable');
+      written.push(record);
+      return record;
+    },
+    readAll() {
+      return written;
+    },
+  };
+}
+
+function runnerOn(store, capacity = 10) {
+  const queue = createQueue({ capacity });
+  return { queue, runner: createRunner({ store, queue, now: () => 7 }) };
+}
+
+test('a store rejection mid-batch leaves the queue exactly as it was', async () => {
+  const store = storeThatRejectsAfter(2);
+  const { queue, runner } = runnerOn(store);
+  queue.enqueue({ id: 'existing' });
+
+  await assert.rejects(
+    () => runner.enqueue(['a', 'b', 'c', 'd']),
+    (error) => error instanceof BackpressureError && error.attempted === 4,
+  );
+
+  assert.equal(queue.size, 1);
+  assert.deepEqual(queue.drain(), [{ id: 'existing' }]);
+});
+
+test('a rejection on the first write reports the whole batch as attempted', async () => {
+  const store = storeThatRejectsAfter(0);
+  const { queue, runner } = runnerOn(store);
+
+  await assert.rejects(
+    () => runner.enqueue(['a', 'b']),
+    (error) => error instanceof BackpressureError && error.attempted === 2,
+  );
+
+  assert.equal(store.written.length, 0);
+  assert.equal(queue.size, 0);
+});
+
+test('a rejection wraps the store failure as its cause', async () => {
+  const store = storeThatRejectsAfter(1);
+  const { runner } = runnerOn(store);
+
+  await assert.rejects(
+    () => runner.enqueue(['a', 'b']),
+    (error) => error instanceof BackpressureError && error.cause.message === 'store is unavailable',
+  );
+});
+
+test('a batch larger than the remaining capacity is refused before any write', async () => {
+  const store = storeThatRejectsAfter(3);
+  const { queue, runner } = runnerOn(store, 2);
+
+  await assert.rejects(() => runner.enqueue(['a', 'b', 'c']), QueueFullError);
+  assert.equal(store.written.length, 0);
+  assert.equal(queue.size, 0);
+});
+
+test('an empty batch returns the current size without touching the store', async () => {
+  const store = storeThatRejectsAfter(0);
+  const { queue, runner } = runnerOn(store);
+  queue.enqueue({ id: 'existing' });
+
+  assert.equal(await runner.enqueue([]), 1);
+  assert.equal(store.written.length, 0);
+  assert.equal(queue.size, 1);
+});
