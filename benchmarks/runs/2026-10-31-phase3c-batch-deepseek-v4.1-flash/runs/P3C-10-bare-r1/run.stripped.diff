diff --git a/test/queue.test.js b/test/queue.test.js
index 9671663..35ae0e5 100644
--- a/test/queue.test.js
+++ b/test/queue.test.js
@@ -88,3 +88,16 @@ test('drain empties the queue and returns the items in order', () => {
   assert.equal(queue.size, 0);
   assert.equal(queue.isFull, false);
 });
+
+test('drain returns a large queue in FIFO order', () => {
+  const count = 20000;
+  const queue = createQueue({ capacity: count });
+  const expected = [];
+  for (let i = 0; i < count; i += 1) {
+    queue.enqueue(i);
+    expected.push(i);
+  }
+  assert.deepEqual(queue.drain(), expected);
+  assert.equal(queue.size, 0);
+  assert.deepEqual(queue.drain(), []);
+});
