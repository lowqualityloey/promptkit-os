+test('a store rejection mid-batch raises BackpressureError naming the batch size', async () => {
+  const store = createStore({ path: 'jobs.jsonl', io: ioThatRejectsAfter(1) });
+  const queue = createQueue({ capacity: 10 });
+  const runner = createRunner({ store, queue, now: () => 7 });
+
+  await assert.rejects(
+    () => runner.enqueue(['a', 'b', 'c']),
+    (error) => error instanceof BackpressureError && error.attempted === 3,
+  );
+
+  assert.equal(queue.size, 0);
+  assert.equal(store.readAll().length, 1);
+});
+
+test('a store rejection mid-batch leaves already-queued jobs untouched', async () => {
+  const store = createStore({ path: 'jobs.jsonl', io: ioThatRejectsAfter(0) });
+  const queue = createQueue({ capacity: 10 });
+  queue.enqueue({ id: 'existing' });
+  const runner = createRunner({ store, queue, now: () => 7 });
+
+  await assert.rejects(
+    () => runner.enqueue(['a', 'b']),
+    (error) => error instanceof BackpressureError && error.attempted === 2,
+  );
+
+  assert.deepEqual(queue.drain(), [{ id: 'existing' }]);
+});
+
+test('a batch the store accepts adds every job in order', async () => {
+  const store = createStore({ path: 'jobs.jsonl', io: ioThatRejectsAfter(3) });
+  const queue = createQueue({ capacity: 10 });
+  const runner = createRunner({ store, queue, now: () => 7 });
+
+  assert.equal(await runner.enqueue(['a', 'b', 'c']), 3);
+  assert.deepEqual(queue.drain(), [{ id: 'a' }, { id: 'b' }, { id: 'c' }]);
+  assert.deepEqual(store.readAll().map((record) => record.id), ['a', 'b', 'c']);
+});
+
+test('an empty batch touches neither the store nor the queue', async () => {
+  const store = createStore({ path: 'jobs.jsonl', io: ioThatRejectsAfter(0) });
+  const queue = createQueue({ capacity: 5 });
+  queue.enqueue({ id: 'existing' });
+  const runner = createRunner({ store, queue, now: () => 7 });
+
+  assert.equal(await runner.enqueue([]), 1);
+  assert.equal(store.readAll().length, 0);
+});
