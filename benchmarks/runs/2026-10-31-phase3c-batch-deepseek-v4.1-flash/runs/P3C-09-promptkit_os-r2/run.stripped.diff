-      queue.enqueue({ id });
+    if (ids.length === 0) return queue.size;
+    if (queue.size + ids.length > queue.capacity) {
+      throw new QueueFullError(queue.capacity);
+    }
+    try {
+      for (const id of ids) {
+        store.append({ type: 'enqueue', id, at: now() });
+      }
