diff --git a/test/queue.test.js b/test/queue.test.js
index 9671663..372f4d5 100644
--- a/test/queue.test.js
+++ b/test/queue.test.js
@@ -88,3 +88,23 @@ test('drain empties the queue and returns the items in order', () => {
   assert.equal(queue.size, 0);
   assert.equal(queue.isFull, false);
 });
+
+test('drain returns an empty array when the queue is empty', () => {
+  const queue = createQueue();
+  assert.deepEqual(queue.drain(), []);
+  assert.equal(queue.size, 0);
+});
+
+test('drain returns a large queue in FIFO order and empties it', () => {
+  const count = 20000;
+  const queue = createQueue({ capacity: Number.POSITIVE_INFINITY });
+  for (let i = 0; i < count; i += 1) queue.enqueue(i);
+
+  const drained = queue.drain();
+
+  assert.equal(drained.length, count);
+  for (let i = 0; i < count; i += 1) assert.equal(drained[i], i);
+  assert.equal(queue.size, 0);
+  assert.equal(queue.isFull, false);
+  assert.deepEqual(queue.drain(), []);
+});
