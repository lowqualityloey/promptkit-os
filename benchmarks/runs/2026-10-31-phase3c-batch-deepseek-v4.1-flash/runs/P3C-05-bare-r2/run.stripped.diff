+test('a batch that does not fit the queue is refused without writing or enqueueing', async () => {
+  const { io, store, queue, runner } = runnerOn([]);
+  await runner.enqueue(['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h']);
+  const written = io.readFileSync('jobs.jsonl');
+  const size = queue.size;
+
+  await assert.rejects(
+    () => runner.enqueue(['i', 'j', 'k']),
+    (error) => error instanceof QueueFullError && error.capacity === 10,
+  );
+
+  assert.equal(queue.size, size);
+  assert.equal(io.readFileSync('jobs.jsonl'), written);
+  assert.deepEqual(store.readAll().map((record) => record.id), [
+    'a', 'b', 'c', 'd', 'e', 'f', 'g', 'h',
+  ]);
+});
+
+test('a batch the store refuses leaves the queue unchanged', async () => {
+  const written = [];
+  let calls = 0;
+  const store = {
+    append(record) {
+      calls += 1;
+      if (calls > 1) throw new Error('store is unavailable');
+      written.push(record);
+      return record;
+    },
+    readAll: () => written,
+  };
+  const queue = createQueue({ capacity: 10 });
+  const runner = createRunner({ store, queue });
+
+  await assert.rejects(
+    () => runner.enqueue(['a', 'b', 'c']),
+    (error) => error instanceof BackpressureError && error.attempted === 3,
+  );
+
+  assert.equal(queue.size, 0);
+  assert.equal(written.length, 1);
+});
