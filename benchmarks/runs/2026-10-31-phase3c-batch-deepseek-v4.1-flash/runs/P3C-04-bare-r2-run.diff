+test('intake skips a finished job and dispatches an unfinished one exactly once', async () => {
+  const { io, runner } = runnerOn([
+    { type: 'enqueue', id: 'finished', at: 1 },
+    { type: 'done', id: 'finished', at: 2 },
+    { type: 'enqueue', id: 'unfinished', at: 3 },
+  ]);
+  const ran = [];
+  const handler = async (job) => {
+    ran.push(job.id);
+    return job.id;
+  };
+
+  await runner.enqueue(['finished', 'unfinished']);
+  await runner.run(handler);
+  await runner.enqueue(['finished', 'unfinished']);
+  await runner.run(handler);
+
+  assert.deepEqual(ran, ['unfinished']);
+
+  const records = io
+    .readFileSync('jobs.jsonl')
+    .split('\n')
+    .filter(Boolean)
+    .map((line) => JSON.parse(line));
+  const closed = records.filter((record) => record.type === 'done' || record.type === 'failed');
+  assert.deepEqual(closed, [
+    { type: 'done', id: 'finished', at: 2 },
+    { type: 'done', id: 'unfinished', at: 7 },
+  ]);
+  assert.equal(records.filter((record) => record.type === 'enqueue' && record.id === 'unfinished').length, 1);
+});
+
