+test('a batch that does not fit the queue writes nothing and queues nothing', async () => {
+  const io = fakeIo('');
+  const store = createStore({ path: 'jobs.jsonl', io });
+  const queue = createQueue({ capacity: 2 });
+  const runner = createRunner({ store, queue, now: () => 7 });
+
+  await runner.enqueue(['a']);
+  const before = io.readFileSync('jobs.jsonl');
+
+  await assert.rejects(
+    () => runner.enqueue(['b', 'c']),
+    (error) => error instanceof QueueFullError && error.capacity === 2,
+  );
+
+  assert.equal(queue.size, 1);
+  assert.deepEqual(queue.peek(), { id: 'a' });
+  assert.equal(io.readFileSync('jobs.jsonl'), before);
+});
