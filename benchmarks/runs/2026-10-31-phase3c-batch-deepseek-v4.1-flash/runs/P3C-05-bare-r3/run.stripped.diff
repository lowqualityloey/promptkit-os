+test('an accepted batch writes one enqueue record per job and queues every one of them', async () => {
+  const { io, queue, runner } = runnerOn([]);
+
+  assert.equal(await runner.enqueue(['a', 'b', 'c']), 3);
+  assert.deepEqual(
+    io.readFileSync('jobs.jsonl').trim().split('\n').map((line) => JSON.parse(line)),
+    [
+      { type: 'enqueue', id: 'a', at: 7 },
+      { type: 'enqueue', id: 'b', at: 7 },
+      { type: 'enqueue', id: 'c', at: 7 },
+    ],
+  );
+  assert.deepEqual(queue.drain().map((entry) => entry.id), ['a', 'b', 'c']);
+});
+
+test('a batch that does not fit the queue leaves the store and the queue unchanged', async () => {
+  const initial = `${JSON.stringify({ type: 'enqueue', id: 'old', at: 1 })}\n`;
+  const io = fakeIo(initial);
+  const store = createStore({ path: 'jobs.jsonl', io });
+  const queue = createQueue({ capacity: 3 });
+  queue.enqueue({ id: 'keep' });
+  const runner = createRunner({ store, queue, now: () => 7 });
+
+  await assert.rejects(
+    () => runner.enqueue(['a', 'b', 'c']),
+    (error) => error instanceof QueueFullError && error.capacity === 3,
+  );
+
+  assert.equal(queue.size, 1);
+  assert.equal(queue.peek().id, 'keep');
+  assert.equal(io.readFileSync('jobs.jsonl'), initial);
+});
+
