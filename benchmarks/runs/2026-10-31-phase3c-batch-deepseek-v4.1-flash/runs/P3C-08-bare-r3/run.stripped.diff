+test('caps the exponential backoff at jitterCapMs', async () => {
+  const queue = queueWith('doomed');
+  const delays = [];
+
+  await dispatch(
+    queue,
+    async () => {
+      throw new Error('nope');
+    },
+    {
+      maxAttempts: 4,
+      baseDelayMs: 100,
+      jitterCapMs: 250,
+      jitter: () => 0.5,
+      sleep: async (delayMs) => {
+        delays.push(delayMs);
+      },
+    },
+  );
+
+  assert.deepEqual(delays, [50, 100, 125]);
+  for (const delayMs of delays) {
+    assert.ok(delayMs <= 250, `${delayMs} exceeds the jitter cap`);
+  }
+});
