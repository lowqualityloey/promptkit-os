+test('intake skips a finished job and dispatches an unfinished one exactly once', async () => {
+  const { io, runner } = runnerOn([
+    { type: 'enqueue', id: 'finished', at: 1 },
+    { type: 'done', id: 'finished', at: 2 },
+    { type: 'enqueue', id: 'unfinished', at: 3 },
+  ]);
+  const ran = [];
+  const handler = async (job) => {
+    ran.push(job.id);
+    return job.id;
+  };
+
+  assert.equal(runner.status().pending, 1);
+
+  await runner.enqueue(['finished', 'unfinished']);
+  const first = await runner.run(handler);
+  assert.deepEqual(ran, ['unfinished']);
+  assert.equal(first.total, 1);
+
+  await runner.enqueue(['finished', 'unfinished']);
+  const second = await runner.run(handler);
+  assert.deepEqual(ran, ['unfinished']);
+  assert.equal(second.total, 0);
+
+  const records = io.readFileSync('jobs.jsonl').trim().split('\n').map((line) => JSON.parse(line));
+  const count = (type, id) => records.filter((record) => record.type === type && record.id === id).length;
+  assert.equal(count('done', 'finished'), 1);
+  assert.equal(count('done', 'unfinished'), 1);
+  assert.equal(count('enqueue', 'unfinished'), 1);
+  assert.equal(runner.status().done, 2);
+  assert.equal(runner.status().pending, 0);
+});
+
