+// Replays the append-only log into the ids it has opened and closed. A job is
+// closed once a `done` or `failed` record names it; an id with only an
+// `enqueue` record is still unfinished.
+function replay(records) {
+  const opened = new Set();
+  const closed = new Set();
+  for (const record of records) {
+    if (record.id === undefined) continue;
+    if (record.type === 'enqueue') opened.add(record.id);
+    else if (record.type === 'done' || record.type === 'failed') closed.add(record.id);
+  }
+  return { opened, closed };
+}
+
