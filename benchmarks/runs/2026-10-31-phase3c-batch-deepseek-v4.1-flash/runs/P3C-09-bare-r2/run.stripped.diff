+export class BackpressureError extends Error {
+  constructor(attempted, { cause } = {}) {
+    super(`store rejected a batch of ${attempted} jobs`);
+    this.name = 'BackpressureError';
+    this.attempted = attempted;
+    if (cause !== undefined) this.cause = cause;
+  }
+}
+
 // Wires a store, a queue and the counters together. `run` drains the queue,
 // records each job's outcome, and returns the dispatcher's result.
 export function createRunner({ store, queue, metrics = createMetrics(), now = () => Date.now(), log = () => {} } = {}) {
+  // Batch intake is all-or-nothing for the queue: the store is written first,
+  // and the queue only changes once every record has landed. A store that
+  // rejects any write in the batch therefore leaves the queue exactly as it
+  // was and the failure surfaces as a BackpressureError.
   async function enqueue(ids) {
-    for (const id of ids) {
-      store.append({ type: 'enqueue', id, at: now() });
-      queue.enqueue({ id });
+    const batch = Array.from(ids);
+    if (batch.length === 0) return queue.size;
+    if (queue.size + batch.length > queue.capacity) throw new QueueFullError(queue.capacity);
+
+    const records = batch.map((id) => ({ type: 'enqueue', id, at: now() }));
+    try {
+      for (const record of records) store.append(record);
+    } catch (error) {
+      throw new BackpressureError(batch.length, { cause: error });
     }
+
+    queue.enqueueMany(batch.map((id) => ({ id })));
     return queue.size;
   }
 
