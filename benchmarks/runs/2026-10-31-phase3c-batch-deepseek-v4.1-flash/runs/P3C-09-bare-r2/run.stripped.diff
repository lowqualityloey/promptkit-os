+test('a store that rejects a write mid-batch leaves the queue exactly as it was', async () => {
+  const store = storeThatRejectsAfter(1);
+  const queue = createQueue({ capacity: 10 });
+  queue.enqueue({ id: 'already-here' });
+  const runner = createRunner({ store, queue });
+
+  await assert.rejects(
+    () => runner.enqueue(['a', 'b', 'c']),
+    (error) => error instanceof BackpressureError && error.attempted === 3 && error.cause instanceof Error,
+  );
+
+  assert.equal(queue.size, 1);
+  assert.deepEqual(queue.drain(), [{ id: 'already-here' }]);
+  assert.deepEqual(store.written.map((record) => record.id), ['a']);
+});
+
+test('a store failure late in the batch keeps the attempted count at the batch size', async () => {
