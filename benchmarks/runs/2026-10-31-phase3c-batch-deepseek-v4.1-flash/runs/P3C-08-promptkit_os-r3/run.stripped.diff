+test('caps the exponential base at jitterCapMs and draws once per wait', async () => {
+  const queue = queueWith('stuck');
+  const delays = [];
+  const draws = [];
+  const samples = [0.5, 0.5, 0.5];
+
+  await dispatch(
+    queue,
+    async () => {
+      throw new Error('stuck');
+    },
+    {
+      maxAttempts: 4,
+      baseDelayMs: 100,
+      jitterCapMs: 150,
+      random: () => {
+        const sample = samples[draws.length];
+        draws.push(sample);
+        return sample;
+      },
+      sleep: async (delayMs) => {
+        delays.push(delayMs);
+      },
+    },
+  );
+
+  assert.equal(draws.length, 3);
+  assert.deepEqual(delays, [50, 75, 75]);
+  for (const delay of delays) assert.ok(delay <= 150);
+});
+
