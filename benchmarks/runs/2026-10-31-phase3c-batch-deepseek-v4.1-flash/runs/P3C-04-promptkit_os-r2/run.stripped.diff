+test('intake skips a finished job and accepts an unfinished one when the same list runs twice', async () => {
+  const { io, runner } = runnerOn([
+    { type: 'enqueue', id: 'finished', at: 1 },
+    { type: 'done', id: 'finished', at: 2 },
+    { type: 'enqueue', id: 'unfinished', at: 3 },
+  ]);
+  const ran = [];
+
+  const firstSize = await runner.enqueue(['finished', 'unfinished']);
+  const firstRun = await runner.run(async (job) => {
+    ran.push(job.id);
+    return job.id;
+  });
+  assert.equal(firstSize, 1);
+  assert.equal(firstRun.total, 1);
+
+  const size = await runner.enqueue(['finished', 'unfinished']);
+  const second = await runner.run(async (job) => {
+    ran.push(job.id);
+    return job.id;
+  });
+
+  assert.equal(size, 0);
+  assert.equal(second.total, 0);
+  assert.deepEqual(ran, ['unfinished']);
+
+  const records = io
+    .readFileSync('jobs.jsonl')
+    .trim()
+    .split('\n')
+    .map((line) => JSON.parse(line));
+  assert.deepEqual(
+    records.filter((record) => record.type === 'done').map((record) => record.id),
+    ['finished', 'unfinished'],
+  );
+});
+
