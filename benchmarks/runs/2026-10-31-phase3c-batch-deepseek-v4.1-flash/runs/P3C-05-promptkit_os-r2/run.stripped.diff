+import { QueueFullError, createQueue } from './queue.js';
 import { createStore } from './store.js';
 
+export class BackpressureError extends Error {
+  constructor(attempted, cause) {
+    super(`store rejected a batch of ${attempted} job(s)`, { cause });
+    this.name = 'BackpressureError';
+    this.attempted = attempted;
+  }
+}
+
 // Wires a store, a queue and the counters together. `run` drains the queue,
 // records each job's outcome, and returns the dispatcher's result.
 export function createRunner({ store, queue, metrics = createMetrics(), now = () => Date.now(), log = () => {} } = {}) {
+  // Batch intake is all-or-nothing. Capacity is settled before anything is
+  // written, so a batch the queue cannot take leaves no records behind; the
+  // records are written before the jobs are queued, so a store that refuses a
+  // write never leaves jobs in the queue with no record of them.
   async function enqueue(ids) {
+    if (ids.length === 0) return queue.size;
+
+    if (queue.size + ids.length > queue.capacity) {
+      throw new QueueFullError(queue.capacity);
+    }
+
     for (const id of ids) {
-      store.append({ type: 'enqueue', id, at: now() });
-      queue.enqueue({ id });
+      try {
+        store.append({ type: 'enqueue', id, at: now() });
+      } catch (error) {
+        throw new BackpressureError(ids.length, error);
+      }
     }
+
+    queue.enqueueMany(ids.map((id) => ({ id })));
     return queue.size;
   }
 
