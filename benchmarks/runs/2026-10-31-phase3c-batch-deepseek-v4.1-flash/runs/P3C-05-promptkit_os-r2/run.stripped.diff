+test('a batch that does not fit the queue writes nothing and queues nothing', async () => {
+  const io = fakeIo('');
+  const store = createStore({ path: 'jobs.jsonl', io });
+  const queue = createQueue({ capacity: 2 });
+  const runner = createRunner({ store, queue, now: () => 7 });
+  queue.enqueue({ id: 'existing' });
+
+  await assert.rejects(
+    () => runner.enqueue(['a', 'b']),
+    (error) => error instanceof QueueFullError && error.capacity === 2,
+  );
+
+  assert.equal(io.files.has('jobs.jsonl'), false);
+  assert.deepEqual(store.readAll(), []);
+  assert.deepEqual(queue.drain(), [{ id: 'existing' }]);
+});
+
+test('a batch that fits records one enqueue per job and queues every job', async () => {
+  const io = fakeIo('');
+  const store = createStore({ path: 'jobs.jsonl', io });
+  const queue = createQueue({ capacity: 3 });
+  const runner = createRunner({ store, queue, now: () => 7 });
+  queue.enqueue({ id: 'existing' });
+
+  assert.equal(await runner.enqueue(['a', 'b']), 3);
+  assert.deepEqual(
+    store.readAll().map((record) => [record.type, record.id]),
+    [['enqueue', 'a'], ['enqueue', 'b']],
+  );
+  assert.deepEqual(queue.drain(), [{ id: 'existing' }, { id: 'a' }, { id: 'b' }]);
+});
