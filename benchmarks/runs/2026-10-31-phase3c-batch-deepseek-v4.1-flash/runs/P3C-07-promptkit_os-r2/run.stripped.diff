diff --git a/test/store.test.js b/test/store.test.js
index be1a874..78be0e1 100644
--- a/test/store.test.js
+++ b/test/store.test.js
@@ -59,6 +59,44 @@ test('reads records back in order', () => {
   assert.deepEqual(store.readAll().map((record) => record.id), ['a', 'a']);
 });
 
+test('writes new records as generation 2', () => {
+  const io = memoryIo();
+  const store = createStore({ path: '/s/jobs.jsonl', io });
+  store.append({ type: 'enqueue', id: 'a' });
+
+  const line = io.files.get('/s/jobs.jsonl').split('\n').filter(Boolean)[0];
+  assert.equal(JSON.parse(line).version, 2);
+  assert.equal(store.readAll()[0].version, 2);
+});
+
+test('reads a file written before versioning as generation 1', () => {
+  const store = createStore({
+    path: '/s/jobs.jsonl',
+    io: memoryIo('{"type":"enqueue","id":"a"}\n{"type":"done","id":"a"}\n'),
+  });
+
+  const records = store.readAll();
+  assert.deepEqual(records.map((record) => record.type), ['enqueue', 'done']);
+  assert.deepEqual(records.map((record) => record.version), [1, 1]);
+});
+
+test('reads a mixed-generation file without rewriting either generation', () => {
+  const initial = '{"type":"enqueue","id":"old"}\n{"version":2,"type":"done","id":"old"}\n';
+  const io = memoryIo(initial);
+  const store = createStore({ path: '/s/jobs.jsonl', io });
+
+  const records = store.readAll();
+  assert.deepEqual(records.map((record) => record.id), ['old', 'old']);
+  assert.deepEqual(records.map((record) => record.version), [1, 2]);
+  assert.equal(io.files.get('/s/jobs.jsonl'), initial);
+});
+
+test('fails closed on a version this build does not know', () => {
+  const store = createStore({ path: '/s/jobs.jsonl', io: memoryIo('{"version":3,"type":"enqueue"}\n') });
+  assert.throws(() => store.readAll(), StoreError);
+  assert.throws(() => store.readAll(), /unknown store record version: 3/);
+});
+
 test('fails closed on a line that is not JSON', () => {
