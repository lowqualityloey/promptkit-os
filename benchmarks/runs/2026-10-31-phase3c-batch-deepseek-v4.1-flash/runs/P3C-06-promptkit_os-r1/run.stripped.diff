+test('counts mirror the result arrays as integers', async () => {
+  const queue = queueWith('a', 'b', 'bad');
+  const result = await dispatch(
+    queue,
+    async (job) => {
+      if (job.id === 'bad') throw new Error('nope');
+      return job.id;
+    },
+    { maxAttempts: 1, log: () => {} },
+  );
+
+  assert.equal(result.processed.length, 2);
+  assert.equal(result.failed.length, 1);
+  assert.deepEqual(result.counts, { processed: 2, failed: 1, total: 3 });
+  assert.equal(result.counts.total, result.total);
+  for (const value of Object.values(result.counts)) {
+    assert.ok(Number.isInteger(value));
+  }
+});
+
+test('counts are all zero for an empty queue', async () => {
+  const result = await dispatch(createQueue(), async () => 'ok');
+  assert.deepEqual(result.counts, { processed: 0, failed: 0, total: 0 });
+});
+
+test('a retried failure counts once, not once per attempt', async () => {
+  const queue = queueWith('flaky');
+  const result = await dispatch(
+    queue,
+    async () => {
+      throw new Error('still broken');
+    },
+    { maxAttempts: 3, sleep: async () => {}, log: () => {} },
+  );
+
+  assert.equal(result.counts.failed, 1);
+  assert.equal(result.counts.total, 1);
+});
+
