@@ -1,3 +1,12 @@
+import { dispatch } from './dispatcher.js';
+
+// Drains a queue through `dispatch` and reports how many jobs ran, read from
+// the dispatcher's job counts rather than the number of results it returned.
+export async function sweep(queue, handler, options = {}) {
+  const result = await dispatch(queue, handler, options);
+  return result.counts.total;
+}
