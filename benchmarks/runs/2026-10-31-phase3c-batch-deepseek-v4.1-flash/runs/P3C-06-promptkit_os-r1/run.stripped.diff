+
+function queueWith(...ids) {
+  const queue = createQueue({ capacity: ids.length + 1 });
+  for (const id of ids) queue.enqueue({ id });
+  return queue;
+}
+
+test('sweep drains the queue through the handler and returns the job count', async () => {
+  const queue = queueWith('a', 'b', 'c');
+  const seen = [];
+
+  const ran = await sweep(queue, async (job) => {
+    seen.push(job.id);
+    return job.id;
+  });
+
+  assert.equal(ran, 3);
+  assert.deepEqual(seen, ['a', 'b', 'c']);
+  assert.equal(queue.size, 0);
+});
+
+test('sweep counts failed jobs toward what it reports', async () => {
+  const queue = queueWith('ok', 'bad');
+
+  const ran = await sweep(
+    queue,
+    async (job) => {
+      if (job.id === 'bad') throw new Error('nope');
+      return job.id;
+    },
+    { maxAttempts: 1 },
+  );
+
+  assert.equal(ran, 2);
+  assert.equal(queue.size, 0);
+});
+
+test('sweep forwards dispatch options so retries count as one job', async () => {
+  const queue = queueWith('flaky');
+  let calls = 0;
+
+  const ran = await sweep(
+    queue,
+    async () => {
+      calls += 1;
+      if (calls < 2) throw new Error('transient');
+      return 'ok';
+    },
+    { sleep: async () => {}, log: () => {} },
+  );
+
+  assert.equal(calls, 2);
+  assert.equal(ran, 1);
+});
+
+test('sweep returns zero for an empty queue', async () => {
+  const ran = await sweep(createQueue(), async () => 'ok');
+  assert.equal(ran, 0);
+});
