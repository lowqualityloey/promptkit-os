--- /dev/null
+++ b/test/app.test.js
@@ -0,0 +1,93 @@
+import test from 'node:test';
+import assert from 'node:assert';
+
+import { BackpressureError, createRunner } from '../src/app.js';
+import { createQueue } from '../src/queue.js';
+
+function storeThatRejectsAfter(accepted) {
+  const written = [];
+  let calls = 0;
+  return {
+    written,
+    append(record) {
+      calls += 1;
+      if (calls > accepted) throw new Error('store is unavailable');
+      written.push(record);
+      return record;
+    },
+    readAll() {
+      return written;
+    },
+  };
+}
+
+test('a mid-batch rejection raises BackpressureError and leaves the queue untouched', async () => {
+  const store = storeThatRejectsAfter(1);
+  const queue = createQueue({ capacity: 10 });
+  const runner = createRunner({ store, queue, now: () => 7 });
+
+  await assert.rejects(
+    () => runner.enqueue(['a', 'b', 'c']),
+    (error) =>
+      error instanceof BackpressureError &&
+      error.name === 'BackpressureError' &&
+      error.attempted === 3,
+  );
+
+  assert.equal(queue.size, 0);
+  assert.equal(queue.peek(), undefined);
+  assert.deepEqual(store.written.map((record) => record.id), ['a']);
+  assert.deepEqual(store.written.map((record) => record.type), ['enqueue']);
+});
+
+test('a rejection on the first write still reports the whole batch size', async () => {
+  const store = storeThatRejectsAfter(0);
+  const queue = createQueue({ capacity: 10 });
+  const runner = createRunner({ store, queue });
+
+  await assert.rejects(
+    () => runner.enqueue(['a', 'b']),
+    (error) => error instanceof BackpressureError && error.attempted === 2,
+  );
+
+  assert.equal(queue.size, 0);
+  assert.equal(store.written.length, 0);
+});
+
+test('a rejected batch does not disturb jobs already queued', async () => {
+  const store = storeThatRejectsAfter(0);
+  const queue = createQueue({ capacity: 10 });
+  const runner = createRunner({ store, queue });
+
+  queue.enqueue({ id: 'existing' });
+
+  await assert.rejects(
+    () => runner.enqueue(['a', 'b', 'c']),
+    (error) => error instanceof BackpressureError && error.attempted === 3,
+  );
+
+  assert.equal(queue.size, 1);
+  assert.deepEqual(queue.peek(), { id: 'existing' });
+});
+
+test('an accepted batch adds every job in order and returns the new size', async () => {
+  const store = storeThatRejectsAfter(3);
+  const queue = createQueue({ capacity: 10 });
+  const runner = createRunner({ store, queue });
+
+  assert.equal(await runner.enqueue(['a', 'b', 'c']), 3);
+  assert.deepEqual(queue.drain(), [{ id: 'a' }, { id: 'b' }, { id: 'c' }]);
+  assert.deepEqual(store.written.map((record) => record.id), ['a', 'b', 'c']);
+});
+
+test('an empty batch writes nothing and returns the current size', async () => {
+  const store = storeThatRejectsAfter(0);
+  const queue = createQueue({ capacity: 5 });
+  const runner = createRunner({ store, queue });
+
+  queue.enqueue({ id: 'existing' });
+
+  assert.equal(await runner.enqueue([]), 1);
+  assert.equal(store.written.length, 0);
+  assert.equal(queue.size, 1);
+});
