diff --git a/test/store.test.js b/test/store.test.js
index be1a874..d4778f9 100644
--- a/test/store.test.js
+++ b/test/store.test.js
@@ -59,6 +59,54 @@ test('reads records back in order', () => {
   assert.deepEqual(store.readAll().map((record) => record.id), ['a', 'a']);
 });
 
+test('stamps records written now with version 2', () => {
+  const io = memoryIo();
+  const store = createStore({ path: '/s/jobs.jsonl', io });
+  const returned = store.append({ type: 'enqueue', id: 'a' });
+
+  const [line] = io.files.get('/s/jobs.jsonl').split('\n').filter(Boolean);
+  assert.equal(JSON.parse(line).version, 2);
+  assert.equal(returned.version, 2);
+  assert.equal(store.readAll()[0].version, 2);
+});
+
+test('reads a file written before versioning as version 1', () => {
+  const io = memoryIo('{"type":"enqueue","id":"a"}\n{"type":"done","id":"a"}\n');
+  const store = createStore({ path: '/s/jobs.jsonl', io });
+
+  const records = store.readAll();
+  assert.deepEqual(records.map((record) => record.version), [1, 1]);
+  assert.deepEqual(records.map((record) => record.type), ['enqueue', 'done']);
+  assert.deepEqual(records.map((record) => record.id), ['a', 'a']);
+});
+
+test('reads a mixed file by each record\'s own version', () => {
+  const io = memoryIo('{"type":"enqueue","id":"a"}\n{"version":2,"type":"done","id":"a"}\n');
+  const store = createStore({ path: '/s/jobs.jsonl', io });
+
+  const records = store.readAll();
+  assert.deepEqual(records.map((record) => record.version), [1, 2]);
+  assert.deepEqual(records.map((record) => record.type), ['enqueue', 'done']);
+});
+
+test('appending leaves the existing lines exactly as they were', () => {
+  const original = '{"type":"enqueue","id":"a"}\n';
+  const io = memoryIo(original);
+  const store = createStore({ path: '/s/jobs.jsonl', io });
+  store.append({ type: 'done', id: 'a' });
+
+  const written = io.files.get('/s/jobs.jsonl');
+  assert.ok(written.startsWith(original));
+  assert.equal(JSON.parse(written.split('\n')[1]).version, 2);
+});
+
+test('refuses a record from an unknown format version', () => {
+  const io = memoryIo('{"version":3,"type":"enqueue","id":"a"}\n');
+  const store = createStore({ path: '/s/jobs.jsonl', io });
+  assert.throws(() => store.readAll(), StoreError);
+  assert.throws(() => store.readAll(), /unknown format version/);
+});
+
 test('fails closed on a line that is not JSON', () => {
