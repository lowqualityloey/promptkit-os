+// Raised when the store refuses a write partway through a batch. `attempted` is
+// the size of the batch that was offered, not the number of records written:
+// the caller needs to know what it asked for. The queue is left untouched.
+export class BackpressureError extends Error {
+  constructor(attempted, { cause } = {}) {
+    super(`store rejected a batch of ${attempted} jobs`);
+    this.name = 'BackpressureError';
+    this.attempted = attempted;
+    if (cause !== undefined) this.cause = cause;
+  }
+}
