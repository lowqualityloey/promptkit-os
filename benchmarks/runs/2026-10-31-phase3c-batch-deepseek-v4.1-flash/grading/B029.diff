+test('intake skips a finished job and dispatches an unfinished one once', async () => {
+  const { io, queue, runner } = runnerOn([
+    { type: 'enqueue', id: 'finished', at: 1 },
+    { type: 'done', id: 'finished', at: 2 },
+    { type: 'enqueue', id: 'unfinished', at: 3 },
+  ]);
+
+  const ran = [];
+  const handler = async (job) => {
+    ran.push(job.id);
+    return job.id;
+  };
+
+  await runner.enqueue(['finished', 'unfinished']);
+  await runner.enqueue(['finished', 'unfinished']);
+  assert.equal(queue.size, 1);
+  await runner.run(handler);
+  await runner.run(handler);
+
+  assert.deepEqual(ran, ['unfinished']);
+  const records = io.readFileSync('jobs.jsonl').trim().split('\n').map((line) => JSON.parse(line));
+  assert.equal(records.filter((record) => record.id === 'finished').length, 2);
+  assert.equal(records.filter((record) => record.id === 'unfinished' && record.type === 'enqueue').length, 1);
+  assert.equal(records.filter((record) => record.id === 'unfinished' && record.type === 'done').length, 1);
+});
