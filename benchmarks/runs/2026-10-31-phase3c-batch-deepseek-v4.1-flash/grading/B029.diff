+function jobState(records) {
+  const recorded = new Set();
+  const closed = new Set();
+  for (const record of records) {
+    if (record.type === 'enqueue') {
+      recorded.add(record.id);
+    } else if (record.type === 'done' || record.type === 'failed') {
+      recorded.add(record.id);
+      closed.add(record.id);
+    }
+  }
+  return { recorded, closed };
+}
