@@ -10,6 +10,22 @@ export class StoreError extends Error {
 
 const defaultIo = { appendFileSync, existsSync, mkdirSync, readFileSync };
 
+// Replays records into the state of each job: `enqueue` opens a job as pending,
+// and the first `done` or `failed` closes it. A later `enqueue` never reopens a
+// closed job, so a closed job stays closed however many generations of records
+// are mixed together.
+export function jobStates(records) {
+  const states = new Map();
+  for (const record of records) {
+    if (record.type === 'enqueue') {
+      if (!states.has(record.id)) states.set(record.id, 'pending');
+    } else if (record.type === 'done' || record.type === 'failed') {
+      states.set(record.id, record.type);
+    }
+  }
+  return states;
+}
+
