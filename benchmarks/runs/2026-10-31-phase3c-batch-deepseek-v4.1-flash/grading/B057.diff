+test('intake skips a finished job and dispatches an unfinished one once', async () => {
+  const { io, runner } = runnerOn([
+    { type: 'enqueue', id: 'finished', at: 1 },
+    { type: 'done', id: 'finished', at: 2 },
+    { type: 'enqueue', id: 'unfinished', at: 1 },
+  ]);
+
+  const ran = [];
+  const handler = async (job) => {
+    ran.push(job.id);
+    return job.id;
+  };
+
+  for (let pass = 0; pass < 2; pass += 1) {
+    await runner.enqueue(['finished', 'unfinished']);
+    await runner.run(handler);
+  }
+
+  assert.deepEqual(ran, ['unfinished']);
+
+  const records = io
+    .readFileSync('jobs.jsonl')
+    .split('\n')
+    .filter(Boolean)
+    .map((line) => JSON.parse(line));
+
+  assert.deepEqual(
+    records.filter((record) => record.id === 'finished'),
+    [
+      { type: 'enqueue', id: 'finished', at: 1 },
+      { type: 'done', id: 'finished', at: 2 },
+    ],
+  );
+  assert.deepEqual(
+    records.filter((record) => record.id === 'unfinished'),
+    [
+      { type: 'enqueue', id: 'unfinished', at: 1 },
+      { type: 'done', id: 'unfinished', at: 7 },
+    ],
+  );
+});
