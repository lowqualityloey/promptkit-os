+test('a batch the queue cannot take leaves the store and the queue unchanged', async () => {
+  const io = fakeIo();
+  const store = createStore({ path: 'jobs.jsonl', io });
+  const queue = createQueue({ capacity: 2 });
+  const runner = createRunner({ store, queue, now: () => 7 });
+
+  await runner.enqueue(['existing']);
+  const storeBefore = io.readFileSync('jobs.jsonl');
+
+  await assert.rejects(
+    () => runner.enqueue(['a', 'b']),
+    (error) => error instanceof QueueFullError && error.capacity === 2,
+  );
+
+  assert.equal(io.readFileSync('jobs.jsonl'), storeBefore);
+  assert.deepEqual(queue.drain(), [{ id: 'existing' }]);
+});
