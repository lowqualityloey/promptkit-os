diff --git a/test/store.test.js b/test/store.test.js
index be1a874..1dedb6a 100644
--- a/test/store.test.js
+++ b/test/store.test.js
@@ -59,6 +59,53 @@ test('reads records back in order', () => {
   assert.deepEqual(store.readAll().map((record) => record.id), ['a', 'a']);
 });
 
+test('writes new records as version 2', () => {
+  const io = memoryIo();
+  const store = createStore({ path: '/s/jobs.jsonl', io });
+  store.append({ type: 'enqueue', id: 'a' });
+
+  const [record] = io.files.get('/s/jobs.jsonl').split('\n').filter(Boolean).map((line) => JSON.parse(line));
+  assert.equal(record.version, 2);
+});
+
+test('reads a file written before versioning as version 1', () => {
+  const initial = '{"type":"enqueue","id":"a"}\n{"type":"done","id":"a"}\n';
+  const io = memoryIo(initial);
+  const store = createStore({ path: '/s/jobs.jsonl', io });
+
+  assert.deepEqual(store.readAll().map((record) => record.version), [1, 1]);
+  assert.deepEqual(store.readAll().map((record) => record.type), ['enqueue', 'done']);
+});
+
+test('appending to a version 1 file leaves its existing lines untouched', () => {
+  const initial = '{"type":"enqueue","id":"a"}\n';
+  const io = memoryIo(initial);
+  const store = createStore({ path: '/s/jobs.jsonl', io });
+
+  store.append({ type: 'done', id: 'a' });
+
+  const text = io.files.get('/s/jobs.jsonl');
+  assert.ok(text.startsWith(initial));
+  const versions = store.readAll().map((record) => record.version);
+  assert.deepEqual(versions, [1, 2]);
+});
+
+test('reads a mixed file, tagging each record with its generation', () => {
+  const io = memoryIo('{"type":"enqueue","id":"a"}\n{"type":"done","id":"a","version":2}\n');
+  const store = createStore({ path: '/s/jobs.jsonl', io });
+
+  assert.deepEqual(store.readAll().map((record) => record.version), [1, 2]);
+  assert.deepEqual(store.readAll().map((record) => record.type), ['enqueue', 'done']);
+});
+
+test('refuses a record with a version this build does not know', () => {
+  const store = createStore({ path: '/s/jobs.jsonl', io: memoryIo('{"type":"enqueue","id":"a","version":3}\n') });
+  assert.throws(() => store.readAll(), (error) => error instanceof StoreError && /unknown version/.test(error.message));
+
+  const stringVersion = createStore({ path: '/s/jobs.jsonl', io: memoryIo('{"type":"enqueue","id":"a","version":"2"}\n') });
+  assert.throws(() => stringVersion.readAll(), (error) => error instanceof StoreError && /unknown version/.test(error.message));
+});
+
 test('fails closed on a line that is not JSON', () => {
   const store = createStore({ path: '/s/jobs.jsonl', io: memoryIo('{"type":"enqueue"}\nnot json\n') });
   assert.throws(() => store.readAll(), StoreError);
